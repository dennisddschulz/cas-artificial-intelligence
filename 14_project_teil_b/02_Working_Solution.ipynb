    "    \"    print(f'  Episode {i+1}/{TOTAL_EPISODES} (without forecast) - Return: {m[\\\"cumulative_return\\\"]:.4f}, Sharpe: {m[\\\"sharpe_ratio\\\"]:.4f}')\\n\"\n",
