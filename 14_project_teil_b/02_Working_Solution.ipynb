    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('\\\\n=== Training PPO WITHOUT Forecast ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create environment without forecast\\n\",\n",
    "    \"df_train_no_forecast = df_train.drop(columns=['forecast'], errors='ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"env_without = EnhancedTradingEnv(\\n\",\n",
    "    \"    df_train_no_forecast,\\n\",\n",
    "    \"    fee=FEE,\\n\",\n",
    "    \"    kappa=KAPPA,\\n\",\n",
    "    \"    initial_cash=INITIAL_CASH,\\n\",\n",
    "    \"    max_leverage=MAX_LEVERAGE\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Remove forecast from feature cols if present\\n\",\n",
    "    \"env_without.feature_cols = [c for c in env_without.feature_cols if c != 'forecast']\\n\",\n",
    "    \"\\n\",\n",
    "    \"obs_dim_without = env_without.observation_space.shape[0]\\n\",\n",
    "    \"print(f'Obs dim (without forecast): {obs_dim_without}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create trainer\\n\",\n",
    "    \"trainer_without = PPOTrainer(\\n\",\n",
    "    \"    obs_dim=obs_dim_without,\\n\",\n",
    "    \"    act_dim=act_dim,\\n\",\n",
    "    \"    device=DEVICE,\\n\",\n",
    "    \"    lr=3e-4,\\n\",\n",
    "    \"    gamma=0.99,\\n\",\n",
    "    \"    gae_lambda=0.95,\\n\",\n",
    "    \"    clip_eps=0.2,\\n\",\n",
    "    \"    vf_coef=0.5,\\n\",\n",
    "    \"    ent_coef=0.001,\\n\",\n",
    "    \"    max_grad_norm=0.5,\\n\",\n",
    "    \"    target_kl=0.1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Simple training loop\\n\",\n",
    "    \"obs, _ = env_without.reset(seed=SEED)\\n\",\n",
    "    \"obs = torch.as_tensor(obs, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"episode_returns_without = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for update in range(TOTAL_UPDATES):\\n\",\n",
    "    \"    done = False\\n\",\n",
    "    \"    ep_reward = 0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    while not done:\\n\",\n",
    "    \"        obs_t = obs.unsqueeze(0) if obs.dim() == 1 else obs\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        with torch.no_grad():\\n\",\n",
    "    \"            dist, value = trainer_without.model(obs_t)\\n\",\n",
    "    \"            u = dist.sample()\\n\",\n",
    "    \"            from ppo_trainer import squash_action\\n\",\n",
    "    \"            a = squash_action(u, -MAX_LEVERAGE, MAX_LEVERAGE)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        obs_next, reward, terminated, truncated, _ = env_without.step(a.cpu().numpy()[0])\\n\",\n",
    "    \"        done = terminated or truncated\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        obs = torch.as_tensor(obs_next, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"        ep_reward += reward\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    episode_returns_without.append(ep_reward)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if (update + 1) % 20 == 0:\\n\",\n",
    "    \"        mean_ret = np.mean(episode_returns_without[-20:])\\n\",\n",
    "    \"        print(f'Update {update+1:3d}/{TOTAL_UPDATES} | Mean reward: {mean_ret:8.2f}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✓ Training WITHOUT forecast complete')\\n\"\n",
    "   ]\n",
