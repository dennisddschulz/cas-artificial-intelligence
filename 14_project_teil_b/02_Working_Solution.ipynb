    "   \"source\": [\n",
    "    \"print('\\\\n=== RESULTS COMPARISON ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create comparison\\n\",\n",
    "    \"comparison = {\\n\",\n",
    "    \"    'Metric': ['Return', 'Sharpe', 'Max DD', 'Volatility', 'Win Rate', 'Calmar', 'Sortino'],\\n\",\n",
    "    \"    'With Forecast': [\\n\",\n",
    "    \"        f\\\"{np.mean([m['cumulative_return'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['sharpe_ratio'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['max_drawdown'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['volatility'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['win_rate'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['calmar_ratio'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['sortino_ratio'] for m in metrics_with]):.4f}\\\",\\n\",\n",
    "    \"    ],\\n\",\n",
    "    \"    'Without Forecast': [\\n\",\n",
    "    \"        f\\\"{np.mean([m['cumulative_return'] for m in metrics_without]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['sharpe_ratio'] for m in metrics_without]):.4f}\\\",\\n\",\n",
    "    \"        f\\\"{np.mean([m['max_drawdown'] for m in metrics_without]):.4f}\\\",\\n\",\n",
