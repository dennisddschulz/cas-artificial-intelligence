    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"import torch.optim as optim\\n\",\n",
    "    \"from torch.distributions import Normal\\n\",\n",
    "n\",\n",
    "    \"import gymnasium as gym\\n\",\n",
    "    \"import yfinance as yf\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.path.insert(0, '/home/isc-den/cas-artificial-intelligence/14_project_teil_b')\\n\",\n",
    "    \"\\n\",\n",
    "    \"from trading_env import EnhancedTradingEnv\\n\",\n",
    "    \"from forecasting import TimeSeriesForecaster\\n\",\n",
    "    \"from ppo_trainer import PPOTrainer\\n\",\n",
    "    \"from evaluation import TradingMetrics, StrategyEvaluator\\n\",\n",
    "    \"\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set seeds\\n\",\n",
    "    \"SEED = 42\\n\",\n",
    "    \"np.random.seed(SEED)\\n\",\n",
    "    \"torch.manual_seed(SEED)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Configuration\\n\",\n",
    "    \"DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\\n\",\n",
    "    \"print(f'Device: {DEVICE}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Simplified parameters for faster execution\\n\",\n",
    "    \"TICKER = 'BTC-USD'\\n\",\n",
    "    \"START = '2023-01-01'\\n\",\n",
    "    \"END = '2024-01-01'\\n\",\n",
    "    \"TRAIN_FRAC = 0.8\\n\",\n",
    "    \"\\n\",\n",
    "    \"FEE = 0.0005\\n\",\n",
    "    \"KAPPA = 0.1\\n\",\n",
    "    \"INITIAL_CASH = 100000.0\\n\",\n",
    "    \"MAX_LEVERAGE = 2.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Reduced for faster training\\n\",\n",
    "    \"TOTAL_UPDATES = 100  # Reduced from 500\\n\",\n",
    "    \"TOTAL_EPISODES = 5   # For testing\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\\\n=== Configuration ===')\\n\",\n",
    "    \"print(f'Data: {TICKER} ({START} to {END})')\\n\",\n",
    "    \"print(f'Updates: {TOTAL_UPDATES}')\\n\",\n",
    "    \"print(f'Test episodes: {TOTAL_EPISODES}')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Load and Process Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('\\\\n=== Loading Data ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load from yfinance\\n\",\n",
    "    \"df = yf.download(TICKER, start=START, end=END, progress=False)\\n\",\n",
    "    \"df = df.dropna()\\n\",\n",
    "    \"if isinstance(df.columns, pd.MultiIndex):\\n\",\n",
    "    \"    df.columns = df.columns.get_level_values(0)\\n\",\n",
    "    \"df.columns = [c.lower() for c in df.columns]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Loaded {len(df)} days')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add features\\n\",\n",
    "    \"df['log_close'] = np.log(df['close'])\\n\",\n",
    "    \"df['r'] = df['log_close'].diff()\\n\",\n",
    "    \"df['mu_hat'] = df['r'].ewm(span=20, adjust=False).mean()\\n\",\n",
    "    \"df['sigma_hat'] = df['r'].rolling(20).std()\\n\",\n",
    "    \"df['r_lag1'] = df['r'].shift(1)\\n\",\n",
    "    \"df['rsi'] = compute_rsi(df['close'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.dropna()\\n\",\n",
    "    \"df = df.reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'After features: {len(df)} days')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Split data\\n\",\n",
    "    \"split_idx = int(len(df) * TRAIN_FRAC)\\n\",\n",
    "    \"df_train = df.iloc[:split_idx].copy()\\n\",\n",
    "    \"df_test = df.iloc[split_idx:].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Train: {len(df_train)} days')\\n\",\n",
    "    \"print(f'Test: {len(df_test)} days')\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_rsi(prices, period=14):\\n\",\n",
    "    \"    delta = prices.diff()\\n\",\n",
    "    \"    gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()\\n\",\n",
    "    \"    loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()\\n\",\n",
    "    \"    rs = gain / (loss + 1e-8)\\n\",\n",
    "    \"    return (100 - (100 / (1 + rs))) / 100.0\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Train Forecasting Model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('\\\\n=== Training LSTM Forecaster ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prepare data for forecasting\\n\",\n",
    "    \"forecast_data = df_train[['r', 'mu_hat', 'sigma_hat']].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create forecaster\\n\",\n",
    "    \"forecaster = TimeSeriesForecaster(\\n\",\n",
    "    \"    input_size=3,\\n\",\n",
    "    \"    hidden_size=32,\\n\",\n",
    "    \"    num_layers=1,\\n\",\n",
    "    \"    forecast_horizon=5,\\n\",\n",
    "    \"    device=DEVICE\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train with reduced epochs\\n\",\n",
    "    \"history = forecaster.train(\\n\",\n",
    "    \"    forecast_data,\\n\",\n",
    "    \"    val_data=None,\\n\",\n",
    "    \"    epochs=50,\\n\",\n",
    "    \"    batch_size=16,\\n\",\n",
    "    \"    lr=0.001\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✓ Forecaster trained')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Generate forecasts\\n\",\n",
    "    \"train_forecasts = forecaster.predict(forecast_data)\\n\",\n",
    "    \"test_forecasts = forecaster.predict(df_test[['r', 'mu_hat', 'sigma_hat']].values)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Train forecasts: {train_forecasts.shape}')\\n\",\n",
    "    \"print(f'Test forecasts: {test_forecasts.shape}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add to dataframes\\n\",\n",
    "    \"df_train['forecast'] = 0.0\\n\",\n",
    "    \"start_idx = 24  # lookback + horizon\\n\",\n",
    "    \"if start_idx < len(df_train):\\n\",\n",
    "    \"    end_idx = min(start_idx + len(train_forecasts), len(df_train))\\n\",\n",
    "    \"    df_train.loc[start_idx:end_idx-1, 'forecast'] = train_forecasts[:end_idx-start_idx, 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_test['forecast'] = 0.0\\n\",\n",
    "    \"if start_idx < len(df_test):\\n\",\n",
    "    \"    end_idx = min(start_idx + len(test_forecasts), len(df_test))\\n\",\n",
    "    \"    df_test.loc[start_idx:end_idx-1, 'forecast'] = test_forecasts[:end_idx-start_idx, 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✓ Forecasts added to data')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Train PPO With Forecast\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print('\\\\n=== Training PPO WITH Forecast ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create environment\\n\",\n",
    "    \"env_with = EnhancedTradingEnv(\\n\",\n",
    "    \"    df_train,\\n\",\n",
    "    \"    fee=FEE,\\n\",\n",
    "    \"    kappa=KAPPA,\\n\",\n",
    "    \"    initial_cash=INITIAL_CASH,\\n\",\n",
    "    \"    max_leverage=MAX_LEVERAGE\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"obs_dim_with = env_with.observation_space.shape[0]\\n\",\n",
    "    \"act_dim = env_with.action_space.shape[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Obs dim: {obs_dim_with}, Act dim: {act_dim}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create trainer\\n\",\n",
    "    \"trainer_with = PPOTrainer(\\n\",\n",
    "    \"    obs_dim=obs_dim_with,\\n\",\n",
    "    \"    act_dim=act_dim,\\n\",\n",
    "    \"    device=DEVICE,\\n\",\n",
    "    \"    lr=3e-4,\\n\",\n",
    "    \"    gamma=0.99,\\n\",\n",
    "    \"    gae_lambda=0.95,\\n\",\n",
    "    \"    clip_eps=0.2,\\n\",\n",
    "    \"    vf_coef=0.5,\\n\",\n",
    "    \"    ent_coef=0.001,\\n\",\n",
    "    \"    max_grad_norm=0.5,\\n\",\n",
    "    \"    target_kl=0.1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Simple training loop (no vectorized envs)\\n\",\n",
    "    \"obs, _ = env_with.reset(seed=SEED)\\n\",\n",
    "    \"obs = torch.as_tensor(obs, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"episode_returns_with = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for update in range(TOTAL_UPDATES):\\n\",\n",
    "    \"    done = False\\n\",\n",
    "    \"    ep_reward = 0\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    while not done:\\n\",\n",
    "    \"        obs_t = obs.unsqueeze(0) if obs.dim() == 1 else obs\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        with torch.no_grad():\\n\",\n",
    "    \"            dist, value = trainer_with.model(obs_t)\\n\",\n",
    "    \"            u = dist.sample()\\n\",\n",
    "    \"            from ppo_trainer import squash_action\\n\",\n",
    "    \"            a = squash_action(u, -MAX_LEVERAGE, MAX_LEVERAGE)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        obs_next, reward, terminated, truncated, _ = env_with.step(a.cpu().numpy()[0])\\n\",\n",
    "    \"        done = terminated or truncated\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        obs = torch.as_tensor(obs_next, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"        ep_reward += reward\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    episode_returns_with.append(ep_reward)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if (update + 1) % 20 == 0:\\n\",\n",
    "    \"        mean_ret = np.mean(episode_returns_with[-20:])\\n\",\n",
    "    \"        print(f'Update {update+1:3d}/{TOTAL_UPDATES} | Mean reward: {mean_ret:8.2f}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('✓ Training WITH forecast complete')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
