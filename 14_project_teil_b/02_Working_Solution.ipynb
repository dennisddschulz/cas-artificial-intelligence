    "   \"source\": [\n",
    "    \"print('\\\\n=== Evaluation on Test Set ===')\\n\",\n",
    "    \"\\n\",\n",
    "    \"evaluator = StrategyEvaluator()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Evaluate WITH forecast\\n\",\n",
    "    \"metrics_with = []\\n\",\n",
    "    \"for i in range(TOTAL_EPISODES):\\n\",\n",
    "    \"    env_eval = EnhancedTradingEnv(df_test, FEE, KAPPA, INITIAL_CASH, MAX_LEVERAGE)\\n\",\n",
    "    \"    m, _ = evaluator.evaluate_episode(env_eval, trainer_with.model, DEVICE, deterministic=True)\\n\",\n",
