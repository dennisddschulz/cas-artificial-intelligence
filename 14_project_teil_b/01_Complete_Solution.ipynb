    "    \"VF_COEF = 0.5\\n\",\n",
    "    \"ENT_COEF = 0.001\\n\",\n",
    "    \"MAX_GRAD_NORM = 0.5\\n\",\n",
    "    \"CLIP_EPS = 0.2\\n\",\n",
    "    \"PPO_EPOCHS = 10\\n\",\n",
    "    \"MINIBATCH_SIZE = 64\\n\",\n",
    "    \"TARGET_KL = 0.1\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n=== Configuration ===\\\")\\n\",\n",
    "    \"print(f\\\"Ticker: {TICKER}\\\")\\n\",\n",
    "    \"print(f\\\"Period: {START} to {END}\\\")\\n\",\n",
    "    \"print(f\\\"Train fraction: {TRAIN_FRAC}\\\")\\n\",\n",
    "    \"print(f\\\"PPO: {NUM_ENVS} envs, {TOTAL_UPDATES} updates\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Load and Preprocess Data\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print(\\\"\\\\n=== Loading Data ===\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_ohlcv(ticker, start, end=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"Load OHLCV data from yfinance.\\\"\\\"\\\"\\n\",\n",
    "    \"    df = yf.download(\\n\",\n",
    "    \"        ticker,\\n\",\n",
    "    \"        start=start,\\n\",\n",
    "    \"        end=end,\\n\",\n",
    "    \"        interval=\\\"1d\\\",\\n\",\n",
    "    \"        auto_adjust=True,\\n\",\n",
    "    \"        progress=False\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    df = df.dropna()\\n\",\n",
    "    \"    if isinstance(df.columns, pd.MultiIndex):\\n\",\n",
    "    \"        df.columns = df.columns.get_level_values(0)\\n\",\n",
    "    \"    df.columns = [c.lower() for c in df.columns]\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_raw = load_ohlcv(TICKER, START, END)\\n\",\n",
    "    \"print(f\\\"Loaded {len(df_raw)} days of data\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add features\\n\",\n",
    "    \"def add_features(df, ewma_span=20, vol_window=20):\\n\",\n",
    "    \"    \\\"\\\"\\\"Add technical features.\\\"\\\"\\\"\\n\",\n",
    "    \"    df = df.copy()\\n\",\n",
    "    \"    df['log_close'] = np.log(df['close'])\\n\",\n",
    "    \"    df['r'] = df['log_close'].diff()\\n\",\n",
    "    \"    df['mu_hat'] = df['r'].ewm(span=ewma_span, adjust=False).mean()\\n\",\n",
    "    \"    df['sigma_hat'] = df['r'].rolling(vol_window).std()\\n\",\n",
    "    \"    df['r_lag1'] = df['r'].shift(1)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Additional features\\n\",\n",
    "    \"    df['rsi'] = compute_rsi(df['close'], period=14)\\n\",\n",
    "    \"    df['macd'], df['signal'] = compute_macd(df['close'])\\n\",\n",
    "    \"    df['bb_upper'], df['bb_lower'] = compute_bollinger_bands(df['close'])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return df.dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_rsi(prices, period=14):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute RSI indicator.\\\"\\\"\\\"\\n\",\n",
    "    \"    delta = prices.diff()\\n\",\n",
    "    \"    gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()\\n\",\n",
    "    \"    loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()\\n\",\n",
    "    \"    rs = gain / (loss + 1e-8)\\n\",\n",
    "    \"    return (100 - (100 / (1 + rs))) / 100.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_macd(prices, fast=12, slow=26, signal=9):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute MACD.\\\"\\\"\\\"\\n\",\n",
    "    \"    ema_fast = prices.ewm(span=fast).mean()\\n\",\n",
    "    \"    ema_slow = prices.ewm(span=slow).mean()\\n\",\n",
    "    \"    macd = ema_fast - ema_slow\\n\",\n",
    "    \"    macd_signal = macd.ewm(span=signal).mean()\\n\",\n",
    "    \"    return macd, macd_signal\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_bollinger_bands(prices, period=20, std_dev=2):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute Bollinger Bands.\\\"\\\"\\\"\\n\",\n",
    "    \"    sma = prices.rolling(window=period).mean()\\n\",\n",
    "    \"    std = prices.rolling(window=period).std()\\n\",\n",
    "    \"    upper = sma + (std_dev * std)\\n\",\n",
    "    \"    lower = sma - (std_dev * std)\\n\",\n",
    "    \"    return upper, lower\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_feat = add_features(df_raw)\\n\",\n",
    "    \"print(f\\\"After features: {len(df_feat)} days\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Split data\\n\",\n",
    "    \"split_idx = int(len(df_feat) * TRAIN_FRAC)\\n\",\n",
    "    \"df_train = df_feat.iloc[:split_idx].reset_index(drop=True)\\n\",\n",
    "    \"df_test = df_feat.iloc[split_idx:].reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Train: {len(df_train)} days, Test: {len(df_test)} days\\\")\\n\",\n",
    "    \"print(f\\\"Train period: {df_train.index[0]} to {df_train.index[-1]}\\\")\\n\",\n",
    "    \"print(f\\\"Test period: {df_test.index[0]} to {df_test.index[-1]}\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Part 2: Train Forecasting Model\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print(\\\"\\\\n=== Training Forecasting Model ===\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prepare forecast data\\n\",\n",
    "    \"forecast_features = df_train[['r', 'mu_hat', 'sigma_hat']].values\\n\",\n",
    "    \"print(f\\\"Forecast input shape: {forecast_features.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Split for validation\\n\",\n",
    "    \"forecast_split = int(len(forecast_features) * 0.8)\\n\",\n",
    "    \"train_feat = forecast_features[:forecast_split]\\n\",\n",
    "    \"val_feat = forecast_features[forecast_split:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train forecaster\\n\",\n",
    "    \"forecaster = TimeSeriesForecaster(\\n\",\n",
    "    \"    input_size=3,\\n\",\n",
    "    \"    hidden_size=64,\\n\",\n",
    "    \"    num_layers=2,\\n\",\n",
    "    \"    forecast_horizon=5,\\n\",\n",
    "    \"    device=DEVICE\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"history = forecaster.train(\\n\",\n",
    "    \"    train_feat,\\n\",\n",
    "    \"    val_data=val_feat,\\n\",\n",
    "    \"    epochs=100,\\n\",\n",
    "    \"    batch_size=32,\\n\",\n",
    "    \"    lr=0.001\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Generate forecasts for full dataset\\n\",\n",
    "    \"all_forecasts_train = forecaster.predict(forecast_features)\\n\",\n",
    "    \"print(f\\\"Train forecasts shape: {all_forecasts_train.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add to training dataframe\\n\",\n",
    "    \"df_train['forecast'] = 0.0\\n\",\n",
    "    \"start_idx = 20 + 5 - 1  # lookback + horizon - 1\\n\",\n",
    "    \"df_train.loc[start_idx:start_idx + len(all_forecasts_train) - 1, 'forecast'] = all_forecasts_train[:, 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Generate forecasts for test set\\n\",\n",
    "    \"test_features = df_test[['r', 'mu_hat', 'sigma_hat']].values\\n\",\n",
    "    \"test_forecasts = forecaster.predict(test_features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_test['forecast'] = 0.0\\n\",\n",
    "    \"df_test.loc[start_idx:start_idx + len(test_forecasts) - 1, 'forecast'] = test_forecasts[:, 0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Train forecast mean: {df_train['forecast'].mean():.6f}, std: {df_train['forecast'].std():.6f}\\\")\\n\",\n",
    "    \"print(f\\\"Test forecast mean: {df_test['forecast'].mean():.6f}, std: {df_test['forecast'].std():.6f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Evaluate forecast quality\\n\",\n",
    "    \"print(\\\"\\\\nForecast Model Validation\\\")\\n\",\n",
    "    \"print(f\\\"Train loss: {history['train_loss'][-1]:.6f}\\\")\\n\",\n",
    "    \"print(f\\\"Val loss: {history['val_loss'][-1]:.6f}\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Part 3: Create Trading Environments\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print(\\\"\\\\n=== Creating Trading Environments ===\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_env_with_forecast(df):\\n\",\n",
    "    \"    def _make():\\n\",\n",
    "    \"        return EnhancedTradingEnv(\\n\",\n",
    "    \"            df,\\n\",\n",
    "    \"            fee=FEE,\\n\",\n",
    "    \"            kappa=KAPPA,\\n\",\n",
    "    \"            initial_cash=INITIAL_CASH,\\n\",\n",
    "    \"            max_leverage=MAX_LEVERAGE\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    return _make\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_env_without_forecast(df):\\n\",\n",
    "    \"    def _make():\\n\",\n",
    "    \"        env = EnhancedTradingEnv(\\n\",\n",
    "    \"            df.drop(columns=['forecast'], errors='ignore'),\\n\",\n",
    "    \"            fee=FEE,\\n\",\n",
    "    \"            kappa=KAPPA,\\n\",\n",
    "    \"            initial_cash=INITIAL_CASH,\\n\",\n",
    "    \"            max_leverage=MAX_LEVERAGE\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        # Remove forecast from feature cols\\n\",\n",
    "    \"        env.feature_cols = [c for c in env.feature_cols if c != 'forecast']\\n\",\n",
    "    \"        return env\\n\",\n",
    "    \"    return _make\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create vectorized environments\\n\",\n",
    "    \"print(\\\"Creating WITH forecast environment...\\\")\\n\",\n",
    "    \"env_with_forecast = gym.vector.SyncVectorEnv(\\n\",\n",
    "    \"    [make_env_with_forecast(df_train) for _ in range(NUM_ENVS)]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Creating WITHOUT forecast environment...\\\")\\n\",\n",
    "    \"env_without_forecast = gym.vector.SyncVectorEnv(\\n\",\n",
    "    \"    [make_env_without_forecast(df_train) for _ in range(NUM_ENVS)]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"obs_dim_with = env_with_forecast.single_observation_space.shape[0]\\n\",\n",
    "    \"obs_dim_without = env_without_forecast.single_observation_space.shape[0]\\n\",\n",
    "    \"act_dim = env_with_forecast.single_action_space.shape[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nObservation space WITH forecast: {obs_dim_with}\\\")\\n\",\n",
    "    \"print(f\\\"Observation space WITHOUT forecast: {obs_dim_without}\\\")\\n\",\n",
    "    \"print(f\\\"Action space: {act_dim}\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Part 4: Train PPO Agents\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print(\\\"\\\\n=== Training PPO Agent WITH Forecast ===\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"trainer_with_forecast = PPOTrainer(\\n\",\n",
    "    \"    obs_dim=obs_dim_with,\\n\",\n",
    "    \"    act_dim=act_dim,\\n\",\n",
    "    \"    device=DEVICE,\\n\",\n",
    "    \"    lr=LR,\\n\",\n",
    "    \"    gamma=GAMMA,\\n\",\n",
    "    \"    gae_lambda=GAE_LAMBDA,\\n\",\n",
    "    \"    clip_eps=CLIP_EPS,\\n\",\n",
    "    \"    vf_coef=VF_COEF,\\n\",\n",
    "    \"    ent_coef=ENT_COEF,\\n\",\n",
    "    \"    max_grad_norm=MAX_GRAD_NORM,\\n\",\n",
    "    \"    target_kl=TARGET_KL\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Training loop\\n\",\n",
    "    \"ep_history_with = []\\n\",\n",
    "    \"update_history_with = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"obs_vec, _ = env_with_forecast.reset(seed=SEED)\\n\",\n",
    "    \"obs_vec = torch.as_tensor(obs_vec, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for update in range(TOTAL_UPDATES):\\n\",\n",
    "    \"    # Collect rollout\\n\",\n",
    "    \"    rollout, obs_vec = trainer_with_forecast.rollout(\\n\",\n",
    "    \"        env_with_forecast, N_STEPS, action_bounds=(-MAX_LEVERAGE, MAX_LEVERAGE)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    ep_history_with.extend(rollout[\\\"ep_history\\\"])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # PPO update\\n\",\n",
    "    \"    metrics = trainer_with_forecast.update(\\n\",\n",
    "    \"        rollout, PPO_EPOCHS, MINIBATCH_SIZE, action_bounds=(-MAX_LEVERAGE, MAX_LEVERAGE)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    update_history_with.append(metrics)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if (update + 1) % 100 == 0:\\n\",\n",
    "    \"        mean_ret = np.mean(ep_history_with[-100:]) if len(ep_history_with) >= 100 else np.nan\\n\",\n",
    "    \"        print(f\\\"Update {update+1:3d}/{TOTAL_UPDATES} | Mean return (last 100): {mean_ret:8.1f}\\\")\\n\",\n",
    "    \"        print(f\\\"  Policy loss: {metrics['policy_loss']:.4f}, Value loss: {metrics['value_loss']:.4f}\\\")\\n\",\n",
    "    \"        print(f\\\"  Approx KL: {metrics['approx_kl']:.6f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n✅ Training WITH forecast complete!\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Train PPO WITHOUT Forecast\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"print(\\\"\\\\n=== Training PPO Agent WITHOUT Forecast ===\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"trainer_without_forecast = PPOTrainer(\\n\",\n",
    "    \"    obs_dim=obs_dim_without,\\n\",\n",
    "    \"    act_dim=act_dim,\\n\",\n",
    "    \"    device=DEVICE,\\n\",\n",
    "    \"    lr=LR,\\n\",\n",
    "    \"    gamma=GAMMA,\\n\",\n",
    "    \"    gae_lambda=GAE_LAMBDA,\\n\",\n",
    "    \"    clip_eps=CLIP_EPS,\\n\",\n",
    "    \"    vf_coef=VF_COEF,\\n\",\n",
    "    \"    ent_coef=ENT_COEF,\\n\",\n",
    "    \"    max_grad_norm=MAX_GRAD_NORM,\\n\",\n",
    "    \"    target_kl=TARGET_KL\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Training loop\\n\",\n",
    "    \"ep_history_without = []\\n\",\n",
    "    \"update_history_without = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"obs_vec, _ = env_without_forecast.reset(seed=SEED)\\n\",\n",
    "    \"obs_vec = torch.as_tensor(obs_vec, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for update in range(TOTAL_UPDATES):\\n\",\n",
    "    \"    # Collect rollout\\n\",\n",
    "    \"    rollout, obs_vec = trainer_without_forecast.rollout(\\n\",\n",
