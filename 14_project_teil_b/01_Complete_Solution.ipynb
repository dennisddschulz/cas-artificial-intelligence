    "    \"# PPO parameters\\n\",\n",
    "    \"NUM_ENVS = 8\\n\",\n",
    "    \"N_STEPS = 128\\n\",\n",
    "    \"TOTAL_UPDATES = 500\\n\",\n",
    "    \"GAMMA = 0.99\\n\",\n",
