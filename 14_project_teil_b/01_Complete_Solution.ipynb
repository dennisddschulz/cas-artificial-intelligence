    "    \"torch.manual_seed(SEED)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Configuration\\n\",\n",
    "    \"TICKER = \\\"BTC-USD\\\"\\n\",\n",
    "    \"START = \\\"2022-01-01\\\"\\n\",\n",
    "    \"END = \\\"2024-01-01\\\"\\n\",\n",
    "    \"TRAIN_FRAC = 0.8\\n\",\n",
    "    \"\\n\",\n",
    "    \"DEVICE = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"print(f\\\"Using device: {DEVICE}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Trading parameters\\n\",\n",
    "    \"FEE = 0.0005\\n\",\n",
    "    \"KAPPA = 0.1\\n\",\n",
    "    \"INITIAL_CASH = 100000.0\\n\",\n",
