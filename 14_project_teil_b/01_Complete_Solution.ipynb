    "    \"import warnings\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Import our modules\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"sys.path.insert(0, '/home/isc-den/cas-artificial-intelligence/14_project_teil_b')\\n\",\n",
    "    \"\\n\",\n",
    "    \"from trading_env import EnhancedTradingEnv, TradingEnvWithForecast, TradingEnvWithoutForecast\\n\",\n",
    "    \"from forecasting import TimeSeriesForecaster, create_forecast_features, ForecastSignalGenerator\\n\",\n",
