    "    \"\\n\",\n",
    "    \"plt.title(\\\"TFT Forecast — Actual vs Quantile Range (Log Returns)\\\", fontsize=16)\\n\",\n",
    "    \"plt.xlabel(\\\"Time\\\", fontsize=13)\\n\",\n",
    "    \"plt.ylabel(\\\"Log Return\\\", fontsize=13)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend(\\n\",\n",
