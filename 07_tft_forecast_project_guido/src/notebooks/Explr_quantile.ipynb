    "    \"        return pd.Series(np.asarray(x))\\n\",\n",
    "    \"    except Exception:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_quantile_band(\\n\",\n",
    "    \"        actual,\\n\",\n",
    "    \"        det_forecast=None,\\n\",\n",
    "    \"        q01=None,\\n\",\n",
    "    \"        q05=None,\\n\",\n",
    "    \"        q09=None,\\n\",\n",
    "    \"        title=\\\"Actual vs Deterministic vs Quantile (0.1/0.5/0.9)\\\",\\n\",\n",
    "    \"        figsize=(12, 6),\\n\",\n",
    "    \"        colors=None,\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    colors = colors or {\\n\",\n",
    "    \"        \\\"actual\\\": \\\"#222222\\\",\\n\",\n",
    "    \"        \\\"det\\\": \\\"#1f77b4\\\",\\n\",\n",
    "    \"        \\\"q05\\\": \\\"#ff7f0e\\\",\\n\",\n",
    "    \"        \\\"band\\\": \\\"#ff7f0e\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    s_actual = to_pd_series(actual)\\n\",\n",
    "    \"    s_det = to_pd_series(det_forecast)\\n\",\n",
    "    \"    s_q01 = to_pd_series(q01)\\n\",\n",
    "    \"    s_q05 = to_pd_series(q05)\\n\",\n",
    "    \"    s_q09 = to_pd_series(q09)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    parts = {}\\n\",\n",
    "    \"    if s_actual is not None:\\n\",\n",
    "    \"        parts[\\\"actual\\\"] = s_actual\\n\",\n",
    "    \"    if s_det is not None:\\n\",\n",
    "    \"        parts[\\\"det\\\"] = s_det\\n\",\n",
    "    \"    if s_q01 is not None:\\n\",\n",
    "    \"        parts[\\\"q01\\\"] = s_q01\\n\",\n",
    "    \"    if s_q05 is not None:\\n\",\n",
    "    \"        parts[\\\"q05\\\"] = s_q05\\n\",\n",
    "    \"    if s_q09 is not None:\\n\",\n",
    "    \"        parts[\\\"q09\\\"] = s_q09\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not parts:\\n\",\n",
    "    \"        raise ValueError(\\\"Provide at least one series (actual, det_forecast or quantiles)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    df = pd.concat(parts.values(), axis=1, keys=parts.keys()).sort_index()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=figsize)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if \\\"q01\\\" in df.columns and \\\"q09\\\" in df.columns:\\n\",\n",
    "    \"        lower = df[\\\"q01\\\"]\\n\",\n",
    "    \"        upper = df[\\\"q09\\\"]\\n\",\n",
    "    \"        valid = ~(lower.isna() | upper.isna())\\n\",\n",
    "    \"        ax.fill_between(\\n\",\n",
    "    \"            df.index,\\n\",\n",
    "    \"            lower,\\n\",\n",
    "    \"            upper,\\n\",\n",
    "    \"            where=valid,\\n\",\n",
    "    \"            color=colors[\\\"band\\\"],\\n\",\n",
    "    \"            alpha=0.18,\\n\",\n",
    "    \"            label=\\\"Quantile 0.1-0.9\\\",\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if \\\"q05\\\" in df.columns:\\n\",\n",
    "    \"        ax.plot(df.index, df[\\\"q05\\\"], color=colors[\\\"q05\\\"], linestyle=\\\"--\\\", label=\\\"Quantile 0.5 (median)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if \\\"det\\\" in df.columns:\\n\",\n",
    "    \"        ax.plot(df.index, df[\\\"det\\\"], color=colors[\\\"det\\\"], label=\\\"Deterministic forecast\\\", linewidth=1.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if \\\"actual\\\" in df.columns:\\n\",\n",
    "    \"        ax.plot(df.index, df[\\\"actual\\\"], color=colors[\\\"actual\\\"], label=\\\"Actual\\\", linewidth=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax.set_title(title)\\n\",\n",
    "    \"    ax.legend()\\n\",\n",
    "    \"    ax.grid(alpha=0.25)\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"    return ax\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Example usage: adjust keys to match your `results` structure if needed ---\\n\",\n",
