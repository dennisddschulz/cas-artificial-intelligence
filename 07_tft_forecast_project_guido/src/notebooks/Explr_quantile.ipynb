    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 🔴 Deterministic forecast\\n\",\n",
    "    \"plt.plot(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    det_y,\\n\",\n",
    "    \"    color=\\\"tab:red\\\",\\n\",\n",
    "    \"    linestyle=\\\"--\\\",\\n\",\n",
    "    \"    linewidth=2,\\n\",\n",
    "    \"    label=\\\"Deterministic (mean)\\\",\\n\",\n",
    "    \"    zorder=3,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ⚫ ACTUAL log-returns\\n\",\n",
    "    \"plt.plot(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    actual_y,\\n\",\n",
    "    \"    color=\\\"orange\\\",\\n\",\n",
    "    \"    linewidth=1.8,\\n\",\n",
