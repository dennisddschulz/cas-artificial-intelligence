    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Extract series\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"actual_y = results[\\\"y_test\\\"].values().squeeze()\\n\",\n",
    "    \"det_y = results[\\\"forecast\\\"].values().squeeze()\\n\",\n",
    "    \"\\n\",\n",
    "    \"q = results[\\\"quantile\\\"][\\\"logret_forecasts\\\"]\\n\",\n",
    "    \"q01_y = q[\\\"q01\\\"].values().squeeze()\\n\",\n",
    "    \"q05_y = q[\\\"q05\\\"].values().squeeze()\\n\",\n",
    "    \"q09_y = q[\\\"q09\\\"].values().squeeze()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Helper: pinball loss\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"def pinball_loss(y, q_hat, q):\\n\",\n",
    "    \"    return np.mean(np.maximum(q * (y - q_hat), (q - 1) * (y - q_hat)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Deterministic metrics\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"rmse_det = results[\\\"rmse\\\"]\\n\",\n",
    "    \"smape_det = results[\\\"smape\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Quantile metrics\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"rmse_q = results[\\\"quantile\\\"][\\\"metrics\\\"][\\\"rmse\\\"]\\n\",\n",
    "    \"smape_q = results[\\\"quantile\\\"][\\\"metrics\\\"][\\\"smape\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"coverage_10_90 = np.mean((actual_y >= q01_y) & (actual_y <= q09_y))\\n\",\n",
    "    \"spread_mean = np.mean(q09_y - q01_y)\\n\",\n",
    "    \"var_violation_rate = np.mean(actual_y < q01_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"pl_01 = pinball_loss(actual_y, q01_y, 0.1)\\n\",\n",
    "    \"pl_05 = pinball_loss(actual_y, q05_y, 0.5)\\n\",\n",
    "    \"pl_09 = pinball_loss(actual_y, q09_y, 0.9)\\n\",\n",
    "    \"pl_avg = np.mean([pl_01, pl_05, pl_09])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Build comparison table\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"df_metrics = pd.DataFrame(\\n\",\n",
    "    \"    {\\n\",\n",
    "    \"        \\\"RMSE\\\": [rmse_det, rmse_q],\\n\",\n",
    "    \"        \\\"sMAPE (%)\\\": [smape_det, smape_q],\\n\",\n",
    "    \"        \\\"Coverage (0.1–0.9)\\\": [np.nan, coverage_10_90],\\n\",\n",
    "    \"        \\\"Mean quantile spread\\\": [np.nan, spread_mean],\\n\",\n",
    "    \"        \\\"VaR(0.1) violation rate\\\": [np.nan, var_violation_rate],\\n\",\n",
    "    \"        \\\"Pinball loss q0.1\\\": [np.nan, pl_01],\\n\",\n",
    "    \"        \\\"Pinball loss q0.5\\\": [np.nan, pl_05],\\n\",\n",
    "    \"        \\\"Pinball loss q0.9\\\": [np.nan, pl_09],\\n\",\n",
    "    \"        \\\"Pinball loss (avg)\\\": [np.nan, pl_avg],\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    index=[\\\"Deterministic (mean)\\\", \\\"Quantile (q-regression)\\\"],\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Display\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"pd.options.display.float_format = \\\"{:.6f}\\\".format\\n\",\n",
    "    \"df_metrics\\n\"\n",
