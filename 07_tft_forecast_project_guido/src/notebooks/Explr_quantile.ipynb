    "   \"source\": [\n",
    "    \"import pickle\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from darts import TimeSeries\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Load results\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"with open(\\\"results.pkl\\\", \\\"rb\\\") as f:\\n\",\n",
    "    \"    results = pickle.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Extract log-return series\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"actual = results[\\\"actual_log_return\\\"]          # ACTUAL log-returns\\n\",\n",
    "    \"det = results[\\\"forecast\\\"]           # deterministic mean forecast\\n\",\n",
    "    \"target_scaler = results[\\\"target_scaler\\\"]\\n\",\n",
    "    \"q = results[\\\"quantile\\\"][\\\"logret_forecasts\\\"]\\n\",\n",
    "    \"q01 = q[\\\"q01\\\"]                      # 0.1\\n\",\n",
    "    \"q05 = q[\\\"q05\\\"]                      # 0.5 (median)\\n\",\n",
    "    \"q09 = q[\\\"q09\\\"]                      # 0.9\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"q01 stats:\\\", q01_y.min(), q01_y.mean(), q01_y.max())\\n\",\n",
    "    \"print(\\\"q05 stats:\\\", q05_y.min(), q05_y.mean(), q05_y.max())\\n\",\n",
    "    \"print(\\\"q09 stats:\\\", q09_y.min(), q09_y.mean(), q09_y.max())\\n\",\n",
    "    \"\\n\",\n",
    "    \"spread = q09_y - q01_y\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nQuantile spread stats:\\\")\\n\",\n",
    "    \"print(\\\"min:\\\", spread.min())\\n\",\n",
    "    \"print(\\\"mean:\\\", spread.mean())\\n\",\n",
    "    \"print(\\\"max:\\\", spread.max())\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def stats(name, x):\\n\",\n",
    "    \"    if isinstance(x, TimeSeries):\\n\",\n",
    "    \"        y = x.values().squeeze()\\n\",\n",
    "    \"    else:  # assume numpy-like\\n\",\n",
    "    \"        y = np.asarray(x).squeeze()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"{name:>10}  \\\"\\n\",\n",
    "    \"        f\\\"mean={y.mean():+.6f}  \\\"\\n\",\n",
    "    \"        f\\\"std={y.std():.6f}  \\\"\\n\",\n",
    "    \"        f\\\"min={y.min():+.6f}  \\\"\\n\",\n",
    "    \"        f\\\"max={y.max():+.6f}\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"def inverse_transform_like_target(target_scaler, ts, target_name=\\\"log_return_morgen\\\"):\\n\",\n",
    "    \"    # Force the component name to match what the scaler was fit on\\n\",\n",
    "    \"    if ts.n_components == 1 and ts.components[0] != target_name:\\n\",\n",
    "    \"        ts2 = ts.with_columns_renamed(ts.components[0], target_name)\\n\",\n",
    "    \"        ts2 = target_scaler.inverse_transform(ts2)\\n\",\n",
    "    \"        return ts2.with_columns_renamed(target_name, ts.components[0])\\n\",\n",
    "    \"    return target_scaler.inverse_transform(ts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"#actual = inverse_transform_like_target(target_scaler, actual, \\\"log_return_morgen\\\")\\n\",\n",
    "    \"#det = inverse_transform_like_target(target_scaler, det, \\\"log_return_morgen\\\")\\n\",\n",
    "    \"#q05 = inverse_transform_like_target(target_scaler, q05, \\\"log_return_morgen\\\")\\n\",\n",
    "    \"#q01 = inverse_transform_like_target(target_scaler, q01, \\\"log_return_morgen\\\")\\n\",\n",
    "    \"#q09 = inverse_transform_like_target(target_scaler, q09, \\\"log_return_morgen\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"stats(\\\"actual\\\", actual)\\n\",\n",
    "    \"stats(\\\"det\\\", det_y)\\n\",\n",
    "    \"stats(\\\"q05\\\", q05_y)\\n\",\n",
    "    \"stats(\\\"q01\\\", q01_y)\\n\",\n",
    "    \"stats(\\\"q09\\\", q09_y)\\n\",\n",
    "    \"stats(\\\"spread\\\", q09_y - q01_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Convert to numpy\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"x = q05.time_index\\n\",\n",
    "    \"\\n\",\n",
    "    \"actual_y = actual.values().squeeze()\\n\",\n",
    "    \"det_y = det.values().squeeze()\\n\",\n",
    "    \"q01_y = q01.values().squeeze()\\n\",\n",
    "    \"q05_y = q05.values().squeeze()\\n\",\n",
    "    \"q09_y = q09.values().squeeze()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Safety check (should ALWAYS hold in log-return space)\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"assert np.all(q01_y <= q05_y)\\n\",\n",
    "    \"assert np.all(q05_y <= q09_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Plot ONLY last N points\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"N = 300\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = x[-N:]\\n\",\n",
    "    \"actual_y = actual_y[-N:]\\n\",\n",
    "    \"det_y = det_y[-N:]\\n\",\n",
    "    \"q01_y = q01_y[-N:]\\n\",\n",
    "    \"q05_y = q05_y[-N:]\\n\",\n",
    "    \"q09_y = q09_y[-N:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"# Plot\\n\",\n",
    "    \"# --------------------------------------------------\\n\",\n",
    "    \"plt.figure(figsize=(16, 7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 🔵 Quantile range\\n\",\n",
    "    \"plt.fill_between(\\n\",\n",
    "    \"    x,\\n\",\n",
    "    \"    q01_y,\\n\",\n",
    "    \"    q09_y,\\n\",\n",
    "    \"    color=\\\"tab:blue\\\",\\n\",\n",
    "    \"    alpha=0.35,\\n\",\n",
    "    \"    label=\\\"Quantile range (0.1 – 0.9)\\\",\\n\",\n",
    "    \"    zorder=1,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 🔷 Quantile median\\n\",\n",
