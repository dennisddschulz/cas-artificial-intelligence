    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"# Die TimeSeries-Objekte von Darts haben eine eingebaute Plot-Methode\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"# 1. Sicherstellen, dass die Prognose als TimeSeries vorliegt\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"# Abhängig davon, wie results gespeichert sind, müssen wir die TimeSeries extrahieren.\\n\",\n",
    "    \"# Wir nehmen an, dass 'forecast_series' das Darts TimeSeries-Objekt der Prognose ist.\\n\",\n",
    "    \"forecast_series = results[\\\"historical_forecasts\\\"][\\\"log_return_morgen\\\"]\\n\",\n",
    "    \"y_test = results[\\\"y_test\\\"]\\n\",\n",
    "    \"y_train_val = results[\\\"y_train_val\\\"]\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"# 2. Die Visualisierung der Prognose (Testbereich)\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"plt.figure(figsize=(16, 6))\\n\",\n",
    "    \"plt.title(\\\"Historische Prognosen vs. Tatsächliche Log-Returns (Test-Set)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Tatsächliche Werte (oft in Schwarz oder Dunkelgrau)\\n\",\n",
    "    \"y_test.plot(label=\\\"Tatsächliche Log-Returns\\\", color=\\\"darkblue\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prognostizierte Werte (oft in Rot oder Orange)\\n\",\n",
    "    \"# Wir plotten die Vorhersage direkt gegen die tatsächlichen Testdaten.\\n\",\n",
    "    \"forecast_series.plot(label=\\\"Historische Prognose (log_return_morgen)\\\", color=\\\"red\\\", linestyle=\\\"--\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"# 3. Optional: Gesamter Verlauf (Train + Test + Prognose)\\n\",\n",
    "    \"# ----------------------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Hinzufügen des Training-Sets, um den Gesamtkontext zu sehen\\n\",\n",
    "    \"plt.figure(figsize=(16, 6))\\n\",\n",
    "    \"plt.title(\\\"Gesamter Zeitverlauf: Training, Test und Prognose\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Training-Set (grau)\\n\",\n",
    "    \"y_train_val.plot(label=\\\"Trainingsdaten (Log-Returns)\\\", color=\\\"lightgrey\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Tatsächliche Werte im Test-Set (dunkelblau)\\n\",\n",
    "    \"y_test.plot(label=\\\"Tatsächliche Testdaten\\\", color=\\\"darkblue\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Prognose (rot)\\n\",\n",
    "    \"forecast_series.plot(label=\\\"Historische Prognose\\\", color=\\\"red\\\", linestyle=\\\"--\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"plt.show()\"\n",
