    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Original-DataFrame\\n\",\n",
    "    \"df = results[\\\"df_feat\\\"].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Zeit-Parameter\\n\",\n",
    "    \"test_size = results[\\\"data\\\"].test_size if \\\"data\\\" in results else 200\\n\",\n",
    "    \"val_size = results[\\\"data\\\"].val_size if \\\"data\\\" in results else 100\\n\",\n",
    "    \"total_len = len(df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Zeitsegmente berechnen\\n\",\n",
    "    \"train_end = total_len - test_size - val_size\\n\",\n",
    "    \"val_end = total_len - test_size\\n\",\n",
    "    \"\\n\",\n",
    "    \"df[\\\"split\\\"] = \\\"train\\\"\\n\",\n",
    "    \"df.iloc[train_end:val_end, df.columns.get_loc(\\\"split\\\")] = \\\"val\\\"\\n\",\n",
    "    \"df.iloc[val_end:, df.columns.get_loc(\\\"split\\\")] = \\\"test\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"colors = {\\\"train\\\": \\\"lightgreen\\\", \\\"val\\\": \\\"red\\\", \\\"test\\\": \\\"lightblue\\\"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# === Plot 1: Close Preis mit Segmentfarben ===\\n\",\n",
    "    \"plt.figure(figsize=(14, 5))\\n\",\n",
    "    \"for split, color in colors.items():\\n\",\n",
    "    \"    segment = df[df[\\\"split\\\"] == split]\\n\",\n",
    "    \"    plt.plot(segment.index, segment[\\\"close\\\"], label=split, color=color)\\n\",\n",
    "    \"plt.title(\\\"Effektiver Close-Preis mit Segmentierung\\\")\\n\",\n",
    "    \"plt.xlabel(\\\"Datum\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Preis\\\")\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# === Plot 2: Log-Returns mit Segmentfarben ===\\n\",\n",
    "    \"plt.figure(figsize=(14, 5))\\n\",\n",
    "    \"for split, color in colors.items():\\n\",\n",
    "    \"    segment = df[df[\\\"split\\\"] == split]\\n\",\n",
    "    \"    plt.plot(segment.index, segment[\\\"log_return\\\"], label=split, color=color)\\n\",\n",
    "    \"plt.title(\\\"Log-Return mit Segmentierung\\\")\\n\",\n",
    "    \"plt.xlabel(\\\"Datum\\\")\\n\",\n",
    "    \"plt.ylabel(\\\"Log-Rendite\\\")\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\"\n",
