    "   \"source\": [\n",
    "    \"historical_forecasts = results[\\\"historical_actual_log_ret\\\"]\\n\",\n",
    "    \"# Korrektur: Wir extrahieren die Werte als NumPy Array mit .values()\\n\",\n",
