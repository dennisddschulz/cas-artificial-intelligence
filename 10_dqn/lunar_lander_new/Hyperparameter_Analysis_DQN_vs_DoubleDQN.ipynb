    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# DQN vs Double DQN: Comprehensive Hyperparameter Analysis\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Assignment Goals\\n\",\n",
    "    \"This notebook analyzes:\\n\",\n",
    "    \"1. **Learning Speed**: How quickly does the agent learn?\\n\",\n",
    "    \"2. **Training Stability**: How stable is the learning process?\\n\",\n",
    "    \"3. **Final Performance**: What's the ultimate performance?\\n\",\n",
    "    \"4. **DQN vs Double DQN**: Key differences in behavior\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Environment: LunarLander-v3\\n\",\n",
    "    \"- **Objective**: Land the lunar module between the flags\\n\",\n",
    "    \"- **State Space**: 8 continuous values (position, velocity, angle, etc.)\\n\",\n",
    "    \"- **Action Space**: 4 discrete actions (nothing, left, main, right engine)\\n\",\n",
    "    \"- **Reward**: +100 for landing, -100 for crashing, fuel costs\\n\",\n",
    "    \"- **Solved**: Average reward ≥ 200 over 100 consecutive episodes\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"from collections import deque\\n\",\n",
    "    \"import random\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"import torch.optim as optim\\n\",\n",
    "    \"import gymnasium as gym\\n\",\n",
    "    \"from typing import Dict, List, Tuple\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from IPython.display import clear_output\\n\",\n",
    "    \"import time\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set style\\n\",\n",
    "    \"sns.set_style(\\\"whitegrid\\\")\\n\",\n",
    "    \"plt.rcParams['figure.dpi'] = 100\\n\",\n",
    "    \"plt.rcParams['figure.figsize'] = (12, 6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"DEVICE = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"print(f\\\"Device: {DEVICE}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Core Components\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def set_seed(seed: int):\\n\",\n",
    "    \"    \\\"\\\"\\\"Set random seeds for reproducibility\\\"\\\"\\\"\\n\",\n",
    "    \"    random.seed(seed)\\n\",\n",
    "    \"    np.random.seed(seed)\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        torch.cuda.manual_seed_all(seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def moving_average(x, window=50):\\n\",\n",
    "    \"    \\\"\\\"\\\"Compute moving average for smoothing\\\"\\\"\\\"\\n\",\n",
    "    \"    if len(x) < window:\\n\",\n",
    "    \"        return x\\n\",\n",
    "    \"    cumsum = np.cumsum(np.insert(x, 0, 0))\\n\",\n",
    "    \"    return (cumsum[window:] - cumsum[:-window]) / window\\n\",\n",
    "    \"\\n\",\n",
    "    \"class ReplayBuffer:\\n\",\n",
    "    \"    \\\"\\\"\\\"Experience Replay Buffer\\\"\\\"\\\"\\n\",\n",
    "    \"    def __init__(self, capacity=100_000):\\n\",\n",
    "    \"        self.buffer = deque(maxlen=capacity)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def push(self, state, action, reward, next_state, done):\\n\",\n",
    "    \"        self.buffer.append((state, action, reward, next_state, done))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def sample(self, batch_size):\\n\",\n",
    "    \"        batch = random.sample(self.buffer, batch_size)\\n\",\n",
    "    \"        states, actions, rewards, next_states, dones = map(np.array, zip(*batch))\\n\",\n",
    "    \"        return (states, actions, rewards.astype(np.float32), \\n\",\n",
    "    \"                next_states, dones.astype(np.float32))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.buffer)\\n\",\n",
    "    \"\\n\",\n",
    "    \"class QNetwork(nn.Module):\\n\",\n",
    "    \"    \\\"\\\"\\\"Q-Network Architecture\\\"\\\"\\\"\\n\",\n",
    "    \"    def __init__(self, state_dim, action_dim, hidden_dim=256):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"        self.net = nn.Sequential(\\n\",\n",
    "    \"            nn.Linear(state_dim, hidden_dim),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden_dim, hidden_dim),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden_dim, action_dim)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        return self.net(x)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## DQN Agent with Configurable Hyperparameters\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class DQNAgent:\\n\",\n",
    "    \"    \\\"\\\"\\\"DQN Agent with full hyperparameter control\\\"\\\"\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, state_dim, action_dim, config):\\n\",\n",
    "    \"        self.state_dim = state_dim\\n\",\n",
    "    \"        self.action_dim = action_dim\\n\",\n",
    "    \"        self.config = config\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Networks\\n\",\n",
    "    \"        self.q_network = QNetwork(state_dim, action_dim, \\n\",\n",
    "    \"                                   config.get('hidden_dim', 256)).to(DEVICE)\\n\",\n",
    "    \"        self.target_network = QNetwork(state_dim, action_dim,\\n\",\n",
    "    \"                                       config.get('hidden_dim', 256)).to(DEVICE)\\n\",\n",
    "    \"        self.target_network.load_state_dict(self.q_network.state_dict())\\n\",\n",
    "    \"        self.target_network.eval()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Optimizer\\n\",\n",
    "    \"        self.optimizer = optim.Adam(self.q_network.parameters(), \\n\",\n",
    "    \"                                    lr=config.get('learning_rate', 5e-4))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Replay Buffer\\n\",\n",
    "    \"        self.buffer = ReplayBuffer(capacity=config.get('buffer_size', 100_000))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Hyperparameters\\n\",\n",
    "    \"        self.batch_size = config.get('batch_size', 64)\\n\",\n",
    "    \"        self.gamma = config.get('gamma', 0.99)\\n\",\n",
    "    \"        self.eps_start = config.get('eps_start', 1.0)\\n\",\n",
    "    \"        self.eps_end = config.get('eps_end', 0.01)\\n\",\n",
    "    \"        self.eps_decay_steps = config.get('eps_decay_steps', 100_000)\\n\",\n",
    "    \"        self.min_buffer_size = config.get('min_buffer_size', 1000)\\n\",\n",
    "    \"        self.target_update_freq = config.get('target_update_freq', 1000)\\n\",\n",
    "    \"        self.train_freq = config.get('train_freq', 4)\\n\",\n",
    "    \"        self.grad_clip = config.get('grad_clip', 10.0)\\n\",\n",
    "    \"        self.double_dqn = config.get('double_dqn', False)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Soft update parameters\\n\",\n",
    "    \"        self.use_soft_update = config.get('use_soft_update', False)\\n\",\n",
    "    \"        self.tau = config.get('tau', 0.005)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Tracking\\n\",\n",
    "    \"        self.step_count = 0\\n\",\n",
    "    \"        self.episode_count = 0\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    def get_epsilon(self, step):\\n\",\n",
    "    \"        \\\"\\\"\\\"Compute current epsilon value\\\"\\\"\\\"\\n\",\n",
    "    \"        fraction = min(1.0, step / self.eps_decay_steps)\\n\",\n",
    "    \"        return self.eps_start + fraction * (self.eps_end - self.eps_start)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    @torch.no_grad()\\n\",\n",
    "    \"    def select_action(self, state, epsilon):\\n\",\n",
    "    \"        \\\"\\\"\\\"Epsilon-greedy action selection\\\"\\\"\\\"\\n\",\n",
    "    \"        if random.random() < epsilon:\\n\",\n",
    "    \"            return random.randrange(self.action_dim)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        state_t = torch.FloatTensor(state).unsqueeze(0).to(DEVICE)\\n\",\n",
    "    \"        q_values = self.q_network(state_t)\\n\",\n",
    "    \"        return int(q_values.argmax(dim=1).item())\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def train_step(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Single training step\\\"\\\"\\\"\\n\",\n",
    "    \"        if len(self.buffer) < self.min_buffer_size:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if len(self.buffer) < self.batch_size:\\n\",\n",
    "    \"            return None\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Sample batch\\n\",\n",
    "    \"        states, actions, rewards, next_states, dones = self.buffer.sample(self.batch_size)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        states = torch.FloatTensor(states).to(DEVICE)\\n\",\n",
    "    \"        actions = torch.LongTensor(actions).to(DEVICE)\\n\",\n",
    "    \"        rewards = torch.FloatTensor(rewards).to(DEVICE)\\n\",\n",
    "    \"        next_states = torch.FloatTensor(next_states).to(DEVICE)\\n\",\n",
    "    \"        dones = torch.FloatTensor(dones).to(DEVICE)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Current Q-values\\n\",\n",
    "    \"        current_q = self.q_network(states).gather(1, actions.unsqueeze(1)).squeeze(1)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Target Q-values\\n\",\n",
    "    \"        with torch.no_grad():\\n\",\n",
    "    \"            if self.double_dqn:\\n\",\n",
    "    \"                # Double DQN: action selection with online network, evaluation with target\\n\",\n",
    "    \"                next_actions = self.q_network(next_states).argmax(dim=1)\\n\",\n",
    "    \"                next_q = self.target_network(next_states).gather(1, next_actions.unsqueeze(1)).squeeze(1)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                # Standard DQN: max Q-value from target network\\n\",\n",
    "    \"                next_q = self.target_network(next_states).max(dim=1)[0]\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            target_q = rewards + self.gamma * (1 - dones) * next_q\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Compute loss\\n\",\n",
    "    \"        loss = nn.functional.mse_loss(current_q, target_q)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Optimize\\n\",\n",
    "    \"        self.optimizer.zero_grad()\\n\",\n",
    "    \"        loss.backward()\\n\",\n",
    "    \"        if self.grad_clip:\\n\",\n",
    "    \"            nn.utils.clip_grad_norm_(self.q_network.parameters(), self.grad_clip)\\n\",\n",
    "    \"        self.optimizer.step()\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        return loss.item()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    @torch.no_grad()\\n\",\n",
    "    \"    def soft_update_target_network(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Soft update: θ_target = τ*θ_online + (1-τ)*θ_target\\\"\\\"\\\"\\n\",\n",
    "    \"        for target_param, online_param in zip(self.target_network.parameters(),\\n\",\n",
    "    \"                                              self.q_network.parameters()):\\n\",\n",
    "    \"            target_param.data.mul_(1.0 - self.tau)\\n\",\n",
    "    \"            target_param.data.add_(self.tau * online_param.data)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def hard_update_target_network(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Hard update: θ_target = θ_online\\\"\\\"\\\"\\n\",\n",
    "    \"        self.target_network.load_state_dict(self.q_network.state_dict())\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def update_target_network(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Update target network based on strategy\\\"\\\"\\\"\\n\",\n",
    "    \"        if self.use_soft_update:\\n\",\n",
    "    \"            self.soft_update_target_network()\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            self.hard_update_target_network()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Training Function with Detailed Logging\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def train_agent(config, seed=0, max_episodes=1000, verbose=True):\\n\",\n",
    "    \"    \\\"\\\"\\\"Train DQN agent with comprehensive logging\\\"\\\"\\\"\\n\",\n",
    "    \"    set_seed(seed)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Environment\\n\",\n",
    "    \"    env = gym.make('LunarLander-v3')\\n\",\n",
    "    \"    env.reset(seed=seed)\\n\",\n",
    "    \"    env.action_space.seed(seed)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    state_dim = env.observation_space.shape[0]\\n\",\n",
    "    \"    action_dim = env.action_space.n\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Agent\\n\",\n",
    "    \"    agent = DQNAgent(state_dim, action_dim, config)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Tracking metrics\\n\",\n",
    "    \"    episode_rewards = []\\n\",\n",
    "    \"    episode_lengths = []\\n\",\n",
    "    \"    losses = []\\n\",\n",
    "    \"    epsilon_values = []\\n\",\n",
    "    \"    buffer_sizes = []\\n\",\n",
    "    \"    steps_per_episode = []\\n\",\n",
    "    \"    training_steps = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Q-value tracking\\n\",\n",
    "    \"    mean_q_values = []\\n\",\n",
    "    \"    max_q_values = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    total_steps = 0\\n\",\n",
    "    \"    start_time = time.time()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for episode in range(max_episodes):\\n\",\n",
    "    \"        state, _ = env.reset()\\n\",\n",
    "    \"        episode_reward = 0\\n\",\n",
    "    \"        episode_length = 0\\n\",\n",
    "    \"        episode_losses = []\\n\",\n",
    "    \"        episode_q_values = []\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        done = False\\n\",\n",
    "    \"        while not done:\\n\",\n",
    "    \"            # Select action\\n\",\n",
    "    \"            epsilon = agent.get_epsilon(total_steps)\\n\",\n",
    "    \"            action = agent.select_action(state, epsilon)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Track Q-values\\n\",\n",
    "    \"            with torch.no_grad():\\n\",\n",
    "    \"                state_t = torch.FloatTensor(state).unsqueeze(0).to(DEVICE)\\n\",\n",
    "    \"                q_vals = agent.q_network(state_t)\\n\",\n",
    "    \"                episode_q_values.append(q_vals.max().item())\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Environment step\\n\",\n",
    "    \"            next_state, reward, terminated, truncated, _ = env.step(action)\\n\",\n",
    "    \"            done = terminated or truncated\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Store transition\\n\",\n",
    "    \"            agent.buffer.push(state, action, reward, next_state, done)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Training\\n\",\n",
    "    \"            if total_steps % agent.train_freq == 0:\\n\",\n",
    "    \"                loss = agent.train_step()\\n\",\n",
    "    \"                if loss is not None:\\n\",\n",
    "    \"                    episode_losses.append(loss)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Update target network\\n\",\n",
    "    \"            if agent.use_soft_update:\\n\",\n",
    "    \"                # Soft update every step\\n\",\n",
    "    \"                agent.update_target_network()\\n\",\n",
    "    \"            elif total_steps % agent.target_update_freq == 0:\\n\",\n",
    "    \"                # Hard update every N steps\\n\",\n",
    "    \"                agent.update_target_network()\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            state = next_state\\n\",\n",
    "    \"            episode_reward += reward\\n\",\n",
    "    \"            episode_length += 1\\n\",\n",
    "    \"            total_steps += 1\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Log episode metrics\\n\",\n",
    "    \"        episode_rewards.append(episode_reward)\\n\",\n",
    "    \"        episode_lengths.append(episode_length)\\n\",\n",
    "    \"        steps_per_episode.append(total_steps)\\n\",\n",
    "    \"        epsilon_values.append(agent.get_epsilon(total_steps))\\n\",\n",
    "    \"        buffer_sizes.append(len(agent.buffer))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if episode_losses:\\n\",\n",
    "    \"            losses.extend(episode_losses)\\n\",\n",
    "    \"            training_steps.extend([total_steps] * len(episode_losses))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        if episode_q_values:\\n\",\n",
    "    \"            mean_q_values.append(np.mean(episode_q_values))\\n\",\n",
    "    \"            max_q_values.append(np.max(episode_q_values))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Progress reporting\\n\",\n",
    "    \"        if verbose and (episode + 1) % 50 == 0:\\n\",\n",
    "    \"            avg_reward = np.mean(episode_rewards[-50:])\\n\",\n",
    "    \"            avg_length = np.mean(episode_lengths[-50:])\\n\",\n",
    "    \"            elapsed = time.time() - start_time\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            clear_output(wait=True)\\n\",\n",
    "    \"            print(f\\\"Episode {episode+1}/{max_episodes}\\\")\\n\",\n",
    "    \"            print(f\\\"  Avg Reward (last 50): {avg_reward:.2f}\\\")\\n\",\n",
    "    \"            print(f\\\"  Avg Length (last 50): {avg_length:.1f}\\\")\\n\",\n",
    "    \"            print(f\\\"  Epsilon: {epsilon_values[-1]:.3f}\\\")\\n\",\n",
    "    \"            print(f\\\"  Buffer Size: {buffer_sizes[-1]}\\\")\\n\",\n",
    "    \"            print(f\\\"  Total Steps: {total_steps}\\\")\\n\",\n",
    "    \"            print(f\\\"  Time Elapsed: {elapsed/60:.1f} min\\\")\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # Check if solved\\n\",\n",
    "    \"            if len(episode_rewards) >= 100:\\n\",\n",
    "    \"                avg_100 = np.mean(episode_rewards[-100:])\\n\",\n",
    "    \"                if avg_100 >= 200:\\n\",\n",
    "    \"                    print(f\\\"\\\\n🎉 Environment SOLVED in {episode+1} episodes!\\\")\\n\",\n",
    "    \"                    print(f\\\"   Average reward over last 100 episodes: {avg_100:.2f}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    env.close()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'config': config,\\n\",\n",
    "    \"        'episode_rewards': np.array(episode_rewards),\\n\",\n",
    "    \"        'episode_lengths': np.array(episode_lengths),\\n\",\n",
    "    \"        'losses': np.array(losses),\\n\",\n",
    "    \"        'epsilon_values': np.array(epsilon_values),\\n\",\n",
    "    \"        'buffer_sizes': np.array(buffer_sizes),\\n\",\n",
    "    \"        'steps_per_episode': np.array(steps_per_episode),\\n\",\n",
    "    \"        'training_steps': np.array(training_steps),\\n\",\n",
    "    \"        'mean_q_values': np.array(mean_q_values),\\n\",\n",
    "    \"        'max_q_values': np.array(max_q_values),\\n\",\n",
    "    \"        'agent': agent\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Baseline Configuration\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
