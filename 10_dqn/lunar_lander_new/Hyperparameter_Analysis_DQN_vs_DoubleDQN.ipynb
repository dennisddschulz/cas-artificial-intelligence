    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def plot_hyperparameter_comparison(results_dict, param_name, figsize=(18, 12)):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Create comprehensive comparison plots for a hyperparameter study\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    fig = plt.figure(figsize=figsize)\\n\",\n",
    "    \"    gs = fig.add_gridspec(3, 3, hspace=0.3, wspace=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 1. Learning Curves (Episode Rewards)\\n\",\n",
    "    \"    ax1 = fig.add_subplot(gs[0, :])\\n\",\n",
    "    \"    for param_val, algorithms in results_dict.items():\\n\",\n",
    "    \"        for alg_name, result in algorithms.items():\\n\",\n",
    "    \"            window = 30\\n\",\n",
    "    \"            smoothed = moving_average(result['episode_rewards'], window)\\n\",\n",
    "    \"            episodes = np.arange(window//2, window//2 + len(smoothed))\\n\",\n",
    "    \"            label = f\\\"{alg_name} ({param_val})\\\"\\n\",\n",
    "    \"            ax1.plot(episodes, smoothed, label=label, linewidth=2, alpha=0.8)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax1.axhline(y=200, color='green', linestyle='--', linewidth=2, alpha=0.6, label='Solved')\\n\",\n",
    "    \"    ax1.set_xlabel('Episode', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax1.set_ylabel('Return (MA-30)', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax1.set_title(f'Learning Speed: {param_name}', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"    ax1.legend(fontsize=8, loc='best')\\n\",\n",
    "    \"    ax1.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 2. Final Performance Comparison\\n\",\n",
    "    \"    ax2 = fig.add_subplot(gs[1, 0])\\n\",\n",
    "    \"    param_vals = list(results_dict.keys())\\n\",\n",
    "    \"    dqn_means = [np.mean(results_dict[pv]['DQN']['episode_rewards'][-50:]) \\n\",\n",
    "    \"                 for pv in param_vals]\\n\",\n",
    "    \"    ddqn_means = [np.mean(results_dict[pv]['DoubleDQN']['episode_rewards'][-50:]) \\n\",\n",
    "    \"                  for pv in param_vals]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    x = np.arange(len(param_vals))\\n\",\n",
    "    \"    width = 0.35\\n\",\n",
    "    \"    ax2.bar(x - width/2, dqn_means, width, label='DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax2.bar(x + width/2, ddqn_means, width, label='Double DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax2.set_xlabel(param_name, fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax2.set_ylabel('Mean Return (Last 50)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax2.set_title('Final Performance', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax2.set_xticks(x)\\n\",\n",
    "    \"    ax2.set_xticklabels([str(pv) for pv in param_vals], rotation=45, ha='right', fontsize=9)\\n\",\n",
    "    \"    ax2.axhline(y=200, color='green', linestyle='--', alpha=0.5)\\n\",\n",
    "    \"    ax2.legend()\\n\",\n",
    "    \"    ax2.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 3. Learning Stability (Variance)\\n\",\n",
    "    \"    ax3 = fig.add_subplot(gs[1, 1])\\n\",\n",
    "    \"    dqn_stds = [np.std(results_dict[pv]['DQN']['episode_rewards'][-50:]) \\n\",\n",
    "    \"                for pv in param_vals]\\n\",\n",
    "    \"    ddqn_stds = [np.std(results_dict[pv]['DoubleDQN']['episode_rewards'][-50:]) \\n\",\n",
    "    \"                 for pv in param_vals]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax3.bar(x - width/2, dqn_stds, width, label='DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax3.bar(x + width/2, ddqn_stds, width, label='Double DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax3.set_xlabel(param_name, fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax3.set_ylabel('Std Dev (Last 50)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax3.set_title('Training Stability (Lower=Better)', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax3.set_xticks(x)\\n\",\n",
    "    \"    ax3.set_xticklabels([str(pv) for pv in param_vals], rotation=45, ha='right', fontsize=9)\\n\",\n",
    "    \"    ax3.legend()\\n\",\n",
    "    \"    ax3.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 4. Episode Lengths\\n\",\n",
    "    \"    ax4 = fig.add_subplot(gs[1, 2])\\n\",\n",
    "    \"    for param_val, algorithms in results_dict.items():\\n\",\n",
    "    \"        for alg_name, result in algorithms.items():\\n\",\n",
    "    \"            window = 30\\n\",\n",
    "    \"            smoothed = moving_average(result['episode_lengths'], window)\\n\",\n",
    "    \"            episodes = np.arange(window//2, window//2 + len(smoothed))\\n\",\n",
    "    \"            label = f\\\"{alg_name} ({param_val})\\\"\\n\",\n",
    "    \"            ax4.plot(episodes, smoothed, label=label, linewidth=2, alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax4.set_xlabel('Episode', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax4.set_ylabel('Length (MA-30)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax4.set_title('Episode Lengths', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax4.legend(fontsize=7, loc='best')\\n\",\n",
    "    \"    ax4.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 5. Training Loss\\n\",\n",
    "    \"    ax5 = fig.add_subplot(gs[2, 0])\\n\",\n",
    "    \"    for param_val, algorithms in results_dict.items():\\n\",\n",
    "    \"        for alg_name, result in algorithms.items():\\n\",\n",
    "    \"            if len(result['losses']) > 0:\\n\",\n",
    "    \"                window = min(500, len(result['losses'])//5 + 1)\\n\",\n",
    "    \"                smoothed = moving_average(result['losses'], window)\\n\",\n",
    "    \"                label = f\\\"{alg_name} ({param_val})\\\"\\n\",\n",
    "    \"                ax5.plot(smoothed, label=label, linewidth=2, alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax5.set_xlabel('Training Steps', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax5.set_ylabel('Loss', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax5.set_title('Training Loss', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax5.legend(fontsize=7, loc='best')\\n\",\n",
    "    \"    ax5.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 6. Q-Values Evolution\\n\",\n",
    "    \"    ax6 = fig.add_subplot(gs[2, 1])\\n\",\n",
    "    \"    for param_val, algorithms in results_dict.items():\\n\",\n",
    "    \"        for alg_name, result in algorithms.items():\\n\",\n",
    "    \"            if len(result['mean_q_values']) > 0:\\n\",\n",
    "    \"                label = f\\\"{alg_name} ({param_val})\\\"\\n\",\n",
    "    \"                ax6.plot(result['mean_q_values'], label=label, linewidth=2, alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax6.set_xlabel('Episode', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax6.set_ylabel('Mean Q-Value', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax6.set_title('Q-Value Evolution', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax6.legend(fontsize=7, loc='best')\\n\",\n",
    "    \"    ax6.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 7. Epsilon Decay\\n\",\n",
    "    \"    ax7 = fig.add_subplot(gs[2, 2])\\n\",\n",
    "    \"    for param_val, algorithms in results_dict.items():\\n\",\n",
    "    \"        for alg_name, result in algorithms.items():\\n\",\n",
    "    \"            episodes = np.arange(len(result['epsilon_values']))\\n\",\n",
    "    \"            label = f\\\"{alg_name} ({param_val})\\\"\\n\",\n",
    "    \"            ax7.plot(episodes, result['epsilon_values'], label=label, linewidth=2, alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax7.set_xlabel('Episode', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax7.set_ylabel('Epsilon', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax7.set_title('Exploration Rate', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax7.legend(fontsize=7, loc='best')\\n\",\n",
    "    \"    ax7.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.savefig(f'hyperparameter_analysis_{param_name.replace(\\\" \\\", \\\"_\\\")}.png', \\n\",\n",
    "    \"                dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return fig\"\n",
    "   ]\n",
