    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Comparative Analysis: DQN vs Double DQN\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def create_dqn_vs_ddqn_summary():\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Create comprehensive DQN vs Double DQN comparison\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    fig = plt.figure(figsize=(20, 12))\\n\",\n",
    "    \"    gs = fig.add_gridspec(3, 4, hspace=0.35, wspace=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Collect all results\\n\",\n",
    "    \"    all_results = [\\n\",\n",
    "    \"        ('Baseline', baseline_dqn, baseline_ddqn),\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Add hyperparameter results\\n\",\n",
    "    \"    for size, res in buffer_results.items():\\n\",\n",
    "    \"        all_results.append((f'Buf{size//1000}k', res['DQN'], res['DoubleDQN']))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 1. Learning curves comparison\\n\",\n",
    "    \"    ax1 = fig.add_subplot(gs[0, :2])\\n\",\n",
    "    \"    for name, dqn_res, ddqn_res in all_results[:4]:  # Show first 4 for clarity\\n\",\n",
    "    \"        window = 30\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # DQN\\n\",\n",
    "    \"        smoothed = moving_average(dqn_res['episode_rewards'], window)\\n\",\n",
    "    \"        episodes = np.arange(window//2, window//2 + len(smoothed))\\n\",\n",
    "    \"        ax1.plot(episodes, smoothed, label=f'DQN-{name}', linewidth=2, alpha=0.7, linestyle='--')\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Double DQN\\n\",\n",
    "    \"        smoothed = moving_average(ddqn_res['episode_rewards'], window)\\n\",\n",
    "    \"        episodes = np.arange(window//2, window//2 + len(smoothed))\\n\",\n",
    "    \"        ax1.plot(episodes, smoothed, label=f'DDQN-{name}', linewidth=2, alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax1.axhline(y=200, color='green', linestyle='--', linewidth=2, alpha=0.5, label='Solved')\\n\",\n",
    "    \"    ax1.set_xlabel('Episode', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax1.set_ylabel('Return (MA-30)', fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax1.set_title('DQN vs Double DQN: Learning Curves', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"    ax1.legend(fontsize=9, loc='best', ncol=2)\\n\",\n",
    "    \"    ax1.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 2. Final performance comparison\\n\",\n",
    "    \"    ax2 = fig.add_subplot(gs[0, 2:])\\n\",\n",
    "    \"    names = [name for name, _, _ in all_results]\\n\",\n",
    "    \"    dqn_final = [np.mean(dqn['episode_rewards'][-50:]) for _, dqn, _ in all_results]\\n\",\n",
    "    \"    ddqn_final = [np.mean(ddqn['episode_rewards'][-50:]) for _, _, ddqn in all_results]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    x = np.arange(len(names))\\n\",\n",
    "    \"    width = 0.35\\n\",\n",
    "    \"    ax2.bar(x - width/2, dqn_final, width, label='DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax2.bar(x + width/2, ddqn_final, width, label='Double DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax2.set_ylabel('Mean Return (Last 50)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax2.set_title('Final Performance Comparison', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"    ax2.set_xticks(x)\\n\",\n",
    "    \"    ax2.set_xticklabels(names, rotation=45, ha='right', fontsize=9)\\n\",\n",
    "    \"    ax2.axhline(y=200, color='green', linestyle='--', alpha=0.5)\\n\",\n",
    "    \"    ax2.legend(fontsize=10)\\n\",\n",
    "    \"    ax2.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 3. Stability comparison\\n\",\n",
    "    \"    ax3 = fig.add_subplot(gs[1, :2])\\n\",\n",
    "    \"    dqn_std = [np.std(dqn['episode_rewards'][-50:]) for _, dqn, _ in all_results]\\n\",\n",
    "    \"    ddqn_std = [np.std(ddqn['episode_rewards'][-50:]) for _, _, ddqn in all_results]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax3.bar(x - width/2, dqn_std, width, label='DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax3.bar(x + width/2, ddqn_std, width, label='Double DQN', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    ax3.set_ylabel('Std Dev (Last 50)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax3.set_title('Training Stability (Lower=Better)', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"    ax3.set_xticks(x)\\n\",\n",
    "    \"    ax3.set_xticklabels(names, rotation=45, ha='right', fontsize=9)\\n\",\n",
    "    \"    ax3.legend(fontsize=10)\\n\",\n",
    "    \"    ax3.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 4. Win rate (which algorithm is better)\\n\",\n",
    "    \"    ax4 = fig.add_subplot(gs[1, 2:])\\n\",\n",
    "    \"    wins = []\\n\",\n",
    "    \"    for _, dqn, ddqn in all_results:\\n\",\n",
    "    \"        dqn_mean = np.mean(dqn['episode_rewards'][-50:])\\n\",\n",
    "    \"        ddqn_mean = np.mean(ddqn['episode_rewards'][-50:])\\n\",\n",
    "    \"        if ddqn_mean > dqn_mean:\\n\",\n",
    "    \"            wins.append(1)  # Double DQN wins\\n\",\n",
    "    \"        elif dqn_mean > ddqn_mean:\\n\",\n",
    "    \"            wins.append(-1)  # DQN wins\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            wins.append(0)  # Tie\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    colors = ['red' if w < 0 else 'green' if w > 0 else 'gray' for w in wins]\\n\",\n",
    "    \"    ax4.barh(names, wins, color=colors, alpha=0.7, edgecolor='black')\\n\",\n",
    "    \"    ax4.axvline(x=0, color='black', linewidth=2)\\n\",\n",
    "    \"    ax4.set_xlabel('Performance Advantage', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax4.set_title('Which Algorithm Wins?\\\\n(Green=DoubleDQN, Red=DQN)', \\n\",\n",
    "    \"                 fontsize=12, fontweight='bold')\\n\",\n",
    "    \"    ax4.set_xlim(-1.5, 1.5)\\n\",\n",
    "    \"    ax4.grid(True, alpha=0.3, axis='x')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 5. Q-value comparison\\n\",\n",
    "    \"    ax5 = fig.add_subplot(gs[2, :2])\\n\",\n",
    "    \"    ax5.plot(baseline_dqn['mean_q_values'], label='DQN', linewidth=2.5, alpha=0.8)\\n\",\n",
    "    \"    ax5.plot(baseline_ddqn['mean_q_values'], label='Double DQN', linewidth=2.5, alpha=0.8)\\n\",\n",
    "    \"    ax5.set_xlabel('Episode', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax5.set_ylabel('Mean Q-Value', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax5.set_title('Q-Value Evolution (Baseline)', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"    ax5.legend(fontsize=10)\\n\",\n",
    "    \"    ax5.grid(True, alpha=0.3)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # 6. Sample efficiency\\n\",\n",
    "    \"    ax6 = fig.add_subplot(gs[2, 2:])\\n\",\n",
    "    \"    for name, dqn_res, ddqn_res in all_results[:4]:\\n\",\n",
    "    \"        # Find episode where reward > 200 first time\\n\",\n",
    "    \"        window = 20\\n\",\n",
    "    \"        dqn_smoothed = moving_average(dqn_res['episode_rewards'], window)\\n\",\n",
    "    \"        ddqn_smoothed = moving_average(ddqn_res['episode_rewards'], window)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        dqn_solved = np.where(dqn_smoothed >= 200)[0]\\n\",\n",
    "    \"        ddqn_solved = np.where(ddqn_smoothed >= 200)[0]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        dqn_ep = dqn_solved[0] if len(dqn_solved) > 0 else len(dqn_res['episode_rewards'])\\n\",\n",
    "    \"        ddqn_ep = ddqn_solved[0] if len(ddqn_solved) > 0 else len(ddqn_res['episode_rewards'])\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        ax6.scatter([dqn_ep], [name], s=100, marker='s', label=f'DQN-{name}', alpha=0.7)\\n\",\n",
    "    \"        ax6.scatter([ddqn_ep], [name], s=100, marker='o', label=f'DDQN-{name}', alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax6.axvline(x=200, color='green', linestyle='--', alpha=0.5)\\n\",\n",
    "    \"    ax6.set_xlabel('Episodes to Solve (First time > 200)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax6.set_title('Sample Efficiency', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"    ax6.legend(fontsize=8, loc='best', ncol=2)\\n\",\n",
    "    \"    ax6.grid(True, alpha=0.3, axis='x')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.savefig('dqn_vs_double_dqn_comprehensive.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"create_dqn_vs_ddqn_summary()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Statistical Summary and Key Findings\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
