    "    \"    {'name': 'DQN_StrongWind', 'double_dqn': False, 'seed': 4, 'wind_power': 15.0, 'turbulence_power': 1.5},\\n\",\n",
    "    \"    {'name': 'DoubleDQN_StrongWind', 'double_dqn': True, 'seed': 5, 'wind_power': 15.0, 'turbulence_power': 1.5}\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Training {len(configs)} configurations with {TRAINING_STEPS:,} steps each\\\")\\n\",\n",
    "    \"print(f\\\"Estimated total time: ~{len(configs) * TRAINING_STEPS / 1000:.0f} minutes\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
