    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# DQN vs Double DQN - Comprehensive Analysis with Wind Variations\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook provides a detailed comparison of DQN and Double DQN algorithms on the LunarLander-v3 environment with various wind conditions.\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Features:\\n\",\n",
    "    \"- Training comparison between DQN and Double DQN\\n\",\n",
    "    \"- Multiple wind conditions (No wind, Moderate wind, Strong wind)\\n\",\n",
    "    \"- Detailed statistics and metrics\\n\",\n",
    "    \"- Comprehensive visualizations\\n\",\n",
    "    \"- Video generation of trained agents\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import math, random, time\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from collections import deque\\n\",\n",
    "    \"from typing import Dict, List, Tuple\\n\",\n",
    "    \"\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"import torch.optim as optim\\n\",\n",
    "    \"\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import imageio.v2 as imageio\\n\",\n",
    "    \"from IPython.display import HTML, display, Image\\n\",\n",
    "    \"import base64\\n\",\n",
    "    \"\\n\",\n",
    "    \"import gymnasium as gym\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Set style\\n\",\n",
    "    \"plt.style.use('seaborn-v0_8-darkgrid' if 'seaborn-v0_8-darkgrid' in plt.style.available else 'ggplot')\\n\",\n",
    "    \"plt.rcParams['figure.figsize'] = (12, 6)\\n\",\n",
    "    \"plt.rcParams['figure.dpi'] = 100\\n\",\n",
    "    \"\\n\",\n",
    "    \"DEVICE = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\\n\",\n",
    "    \"print(f\\\"Device: {DEVICE}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Utility Functions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def set_seed(seed: int):\\n\",\n",
    "    \"    random.seed(seed)\\n\",\n",
    "    \"    np.random.seed(seed)\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        torch.cuda.manual_seed_all(seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def moving_average(x, window=50):\\n\",\n",
    "    \"    x = np.asarray(x, dtype=np.float32)\\n\",\n",
    "    \"    if len(x) < window:\\n\",\n",
    "    \"        return x\\n\",\n",
    "    \"    c = np.cumsum(np.insert(x, 0, 0))\\n\",\n",
    "    \"    return (c[window:] - c[:-window]) / window\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_env(seed=0, render_mode=None, wind_power=0.0, turbulence_power=0.0):\\n\",\n",
    "    \"    \\\"\\\"\\\"Create environment with optional wind settings\\\"\\\"\\\"\\n\",\n",
    "    \"    env = gym.make(\\n\",\n",
    "    \"        \\\"LunarLander-v3\\\", \\n\",\n",
    "    \"        render_mode=render_mode,\\n\",\n",
    "    \"        wind_power=wind_power,\\n\",\n",
    "    \"        turbulence_power=turbulence_power,\\n\",\n",
    "    \"        enable_wind=wind_power > 0 or turbulence_power > 0\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    obs, info = env.reset(seed=seed)\\n\",\n",
    "    \"    env.action_space.seed(seed)\\n\",\n",
    "    \"    return env\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Replay Buffer\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class ReplayBuffer:\\n\",\n",
    "    \"    def __init__(self, capacity=100_000):\\n\",\n",
    "    \"        self.buf = deque(maxlen=capacity)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def push(self, s, a, r, s2, done):\\n\",\n",
    "    \"        self.buf.append((s, a, r, s2, done))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def sample(self, batch_size):\\n\",\n",
    "    \"        batch = random.sample(self.buf, batch_size)\\n\",\n",
    "    \"        s, a, r, s2, d = map(np.array, zip(*batch))\\n\",\n",
    "    \"        return s, a, r.astype(np.float32), s2, d.astype(np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.buf)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Q-Network\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class QNet(nn.Module):\\n\",\n",
    "    \"    def __init__(self, obs_dim, n_actions, hidden=256):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"        self.net = nn.Sequential(\\n\",\n",
    "    \"            nn.Linear(obs_dim, hidden),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden, hidden),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden, n_actions)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        return self.net(x)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Action Selection\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def select_action(q_net, obs, eps, n_actions):\\n\",\n",
    "    \"    if random.random() < eps:\\n\",\n",
    "    \"        return random.randrange(n_actions)\\n\",\n",
    "    \"    obs_t = torch.tensor(obs, dtype=torch.float32, device=DEVICE).unsqueeze(0)\\n\",\n",
    "    \"    q = q_net(obs_t)\\n\",\n",
    "    \"    return int(torch.argmax(q, dim=1).item())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Training Step (DQN vs Double DQN)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def train_step(\\n\",\n",
    "    \"    q_online, q_target, optimizer, buffer,\\n\",\n",
    "    \"    batch_size=64, gamma=0.99, double_dqn=False,\\n\",\n",
    "    \"    grad_clip=10.0\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    \\\"\\\"\\\"Single training step with DQN or Double DQN\\\"\\\"\\\"\\n\",\n",
    "    \"    if len(buffer) < batch_size:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    s, a, r, s2, done = buffer.sample(batch_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    s_t = torch.tensor(s, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"    a_t = torch.tensor(a, dtype=torch.int64, device=DEVICE)\\n\",\n",
    "    \"    r_t = torch.tensor(r, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"    s2_t = torch.tensor(s2, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"    d_t = torch.tensor(done, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Current Q-values\\n\",\n",
    "    \"    q_sa = q_online(s_t).gather(1, a_t.unsqueeze(1)).squeeze(1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        if not double_dqn:\\n\",\n",
    "    \"            # Standard DQN: use max Q-value from target network\\n\",\n",
    "    \"            max_next = q_target(s2_t).max(dim=1)[0]\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            # Double DQN: select action with online network, evaluate with target network\\n\",\n",
    "    \"            a_star = torch.argmax(q_online(s2_t), dim=1)\\n\",\n",
    "    \"            max_next = q_target(s2_t).gather(1, a_star.unsqueeze(1)).squeeze(1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        target = r_t + gamma * (1.0 - d_t) * max_next\\n\",\n",
    "    \"\\n\",\n",
    "    \"    loss = nn.functional.mse_loss(q_sa, target)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    optimizer.zero_grad(set_to_none=True)\\n\",\n",
    "    \"    loss.backward()\\n\",\n",
    "    \"    if grad_clip is not None:\\n\",\n",
    "    \"        nn.utils.clip_grad_norm_(q_online.parameters(), grad_clip)\\n\",\n",
    "    \"    optimizer.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return float(loss.item())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Bias Metrics (Overestimation Analysis)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def bias_metrics(q_online, q_target, states_batch):\\n\",\n",
    "    \"    \\\"\\\"\\\"Measure Q-value overestimation\\\"\\\"\\\"\\n\",\n",
    "    \"    s_t = torch.tensor(states_batch, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"    q_on = q_online(s_t)\\n\",\n",
    "    \"    q_tgt = q_target(s_t)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    mean_maxQ_online = float(q_on.max(dim=1)[0].mean().item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Overestimation gap: difference between max Q in target vs Q of selected action\\n\",\n",
    "    \"    max_tgt = q_tgt.max(dim=1)[0]\\n\",\n",
    "    \"    a_star = torch.argmax(q_on, dim=1)\\n\",\n",
    "    \"    eval_tgt_on_astar = q_tgt.gather(1, a_star.unsqueeze(1)).squeeze(1)\\n\",\n",
    "    \"    gap = float((max_tgt - eval_tgt_on_astar).mean().item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return mean_maxQ_online, gap\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Training Function\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def train_agent(\\n\",\n",
    "    \"    algo_name=\\\"DQN\\\",\\n\",\n",
    "    \"    seed=0,\\n\",\n",
    "    \"    total_steps=100_000,\\n\",\n",
    "    \"    start_learning=5_000,\\n\",\n",
    "    \"    batch_size=64,\\n\",\n",
    "    \"    buffer_size=50_000,\\n\",\n",
    "    \"    gamma=0.99,\\n\",\n",
    "    \"    lr=5e-4,\\n\",\n",
    "    \"    hidden=256,\\n\",\n",
    "    \"    eps_start=1.0,\\n\",\n",
    "    \"    eps_end=0.01,\\n\",\n",
    "    \"    eps_decay_steps=80_000,\\n\",\n",
    "    \"    target_update_every=1_000,\\n\",\n",
    "    \"    train_every=4,\\n\",\n",
    "    \"    double_dqn=False,\\n\",\n",
    "    \"    wind_power=0.0,\\n\",\n",
    "    \"    turbulence_power=0.0,\\n\",\n",
    "    \"    verbose=True\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    \\\"\\\"\\\"Train DQN or Double DQN agent\\\"\\\"\\\"\\n\",\n",
    "    \"    if verbose:\\n\",\n",
    "    \"        print(f\\\"\\\\n{'='*80}\\\")\\n\",\n",
    "    \"        print(f\\\"Training {algo_name}\\\")\\n\",\n",
    "    \"        print(f\\\"  Wind: {wind_power}, Turbulence: {turbulence_power}\\\")\\n\",\n",
    "    \"        print(f\\\"  Total Steps: {total_steps:,}\\\")\\n\",\n",
    "    \"        print(f\\\"{'='*80}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    set_seed(seed)\\n\",\n",
    "    \"    env = make_env(seed=seed, render_mode=None, wind_power=wind_power, turbulence_power=turbulence_power)\\n\",\n",
    "    \"    obs_dim = env.observation_space.shape[0]\\n\",\n",
    "    \"    n_actions = env.action_space.n\\n\",\n",
    "    \"\\n\",\n",
    "    \"    q_online = QNet(obs_dim, n_actions, hidden=hidden).to(DEVICE)\\n\",\n",
    "    \"    q_target = QNet(obs_dim, n_actions, hidden=hidden).to(DEVICE)\\n\",\n",
    "    \"    q_target.load_state_dict(q_online.state_dict())\\n\",\n",
    "    \"    q_target.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    optimizer = optim.Adam(q_online.parameters(), lr=lr)\\n\",\n",
    "    \"    buffer = ReplayBuffer(capacity=buffer_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Logging\\n\",\n",
    "    \"    episode_returns = []\\n\",\n",
    "    \"    episode_lengths = []\\n\",\n",
    "    \"    losses = []\\n\",\n",
    "    \"    eps_log = []\\n\",\n",
    "    \"    action_counts = {i: 0 for i in range(n_actions)}\\n\",\n",
    "    \"    mean_maxQ_log = []\\n\",\n",
    "    \"    gap_log = []\\n\",\n",
    "    \"    step_log = []\\n\",\n",
    "    \"    q_value_history = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    obs, info = env.reset()\\n\",\n",
    "    \"    ep_return = 0.0\\n\",\n",
    "    \"    ep_len = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for step in range(1, total_steps + 1):\\n\",\n",
    "    \"        # Epsilon decay\\n\",\n",
    "    \"        frac = min(1.0, step / max(1, eps_decay_steps))\\n\",\n",
    "    \"        eps = eps_start + frac * (eps_end - eps_start)\\n\",\n",
    "    \"        eps_log.append(eps)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Select and execute action\\n\",\n",
    "    \"        a = select_action(q_online, obs, eps, n_actions)\\n\",\n",
    "    \"        action_counts[a] += 1\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        obs2, r, terminated, truncated, info = env.step(a)\\n\",\n",
    "    \"        done = terminated or truncated\\n\",\n",
    "    \"\\n\",\n",
    "    \"        buffer.push(obs, a, r, obs2, done)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        obs = obs2\\n\",\n",
    "    \"        ep_return += r\\n\",\n",
    "    \"        ep_len += 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Training\\n\",\n",
    "    \"        if step >= start_learning and step % train_every == 0:\\n\",\n",
    "    \"            loss = train_step(\\n\",\n",
    "    \"                q_online, q_target, optimizer, buffer,\\n\",\n",
    "    \"                batch_size=batch_size, gamma=gamma, double_dqn=double_dqn\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            if loss is not None:\\n\",\n",
    "    \"                losses.append(loss)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Update target network\\n\",\n",
    "    \"        if step % target_update_every == 0:\\n\",\n",
    "    \"            q_target.load_state_dict(q_online.state_dict())\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Bias metrics\\n\",\n",
    "    \"        if step % 5_000 == 0 and len(buffer) >= 1_000:\\n\",\n",
    "    \"            s_batch, *_ = buffer.sample(min(512, len(buffer)))\\n\",\n",
    "    \"            mean_maxQ, gap = bias_metrics(q_online, q_target, s_batch)\\n\",\n",
    "    \"            mean_maxQ_log.append(mean_maxQ)\\n\",\n",
    "    \"            gap_log.append(gap)\\n\",\n",
    "    \"            step_log.append(step)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            with torch.no_grad():\\n\",\n",
    "    \"                s_t = torch.tensor(s_batch, dtype=torch.float32, device=DEVICE)\\n\",\n",
    "    \"                q_vals = q_online(s_t).cpu().numpy()\\n\",\n",
    "    \"                q_value_history.append({\\n\",\n",
    "    \"                    'step': step,\\n\",\n",
    "    \"                    'mean': q_vals.mean(),\\n\",\n",
    "    \"                    'std': q_vals.std(),\\n\",\n",
    "    \"                    'max': q_vals.max(),\\n\",\n",
    "    \"                    'min': q_vals.min(),\\n\",\n",
    "    \"                    'q25': np.percentile(q_vals, 25),\\n\",\n",
    "    \"                    'q75': np.percentile(q_vals, 75)\\n\",\n",
    "    \"                })\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Episode end\\n\",\n",
    "    \"        if done:\\n\",\n",
    "    \"            episode_returns.append(ep_return)\\n\",\n",
    "    \"            episode_lengths.append(ep_len)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            if verbose and len(episode_returns) % 50 == 0:\\n\",\n",
    "    \"                avg_return = np.mean(episode_returns[-50:])\\n\",\n",
    "    \"                avg_length = np.mean(episode_lengths[-50:])\\n\",\n",
    "    \"                print(f\\\"  Ep {len(episode_returns):4d}, Step {step:7d}, \\\"\\n\",\n",
    "    \"                      f\\\"Avg Ret: {avg_return:7.1f}, Avg Len: {avg_length:6.1f}, Eps: {eps:.3f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"            obs, info = env.reset()\\n\",\n",
    "    \"            ep_return = 0.0\\n\",\n",
    "    \"            ep_len = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    env.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"name\\\": algo_name,\\n\",\n",
    "    \"        \\\"q_online\\\": q_online,\\n\",\n",
    "    \"        \\\"q_target\\\": q_target,\\n\",\n",
    "    \"        \\\"episode_returns\\\": np.array(episode_returns, dtype=np.float32),\\n\",\n",
    "    \"        \\\"episode_lengths\\\": np.array(episode_lengths, dtype=np.int32),\\n\",\n",
    "    \"        \\\"losses\\\": np.array(losses, dtype=np.float32),\\n\",\n",
    "    \"        \\\"eps\\\": np.array(eps_log, dtype=np.float32),\\n\",\n",
    "    \"        \\\"bias_steps\\\": np.array(step_log, dtype=np.int32),\\n\",\n",
    "    \"        \\\"mean_maxQ\\\": np.array(mean_maxQ_log, dtype=np.float32),\\n\",\n",
    "    \"        \\\"gap\\\": np.array(gap_log, dtype=np.float32),\\n\",\n",
    "    \"        \\\"action_counts\\\": action_counts,\\n\",\n",
    "    \"        \\\"q_value_history\\\": q_value_history,\\n\",\n",
    "    \"        \\\"wind_power\\\": wind_power,\\n\",\n",
    "    \"        \\\"turbulence_power\\\": turbulence_power\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Configuration\\n\",\n",
    "    \"\\n\",\n",
    "    \"Choose your training configuration here:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Training configuration\\n\",\n",
    "    \"# For quick testing, use fewer steps (50k-100k)\\n\",\n",
    "    \"# For full training, use 300k-500k steps\\n\",\n",
    "    \"\\n\",\n",
