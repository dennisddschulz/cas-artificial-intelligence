    "    \"ax.set_ylabel(\\\"Return (MA-100)\\\", fontsize=11, fontweight='bold')\\n\",\n",
    "    \"ax.set_title(\\\"Learning Efficiency (No Wind)\\\", fontsize=13, fontweight='bold')\\n\",\n",
    "    \"ax.axhline(y=200, color='green', linestyle='--', alpha=0.5, linewidth=2, label='Solved')\\n\",\n",
    "    \"ax.legend(fontsize=10)\\n\",\n",
    "    \"ax.grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('dqn_vs_double_dqn_comparison.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Evaluation Function\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def evaluate_agent(q_net, n_episodes=50, seed=42, wind_power=0.0, turbulence_power=0.0):\\n\",\n",
    "    \"    \\\"\\\"\\\"Evaluate trained agent\\\"\\\"\\\"\\n\",\n",
    "    \"    env = make_env(seed=seed, render_mode=None, wind_power=wind_power, turbulence_power=turbulence_power)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    returns = []\\n\",\n",
    "    \"    lengths = []\\n\",\n",
    "    \"    successes = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for ep in range(n_episodes):\\n\",\n",
    "    \"        obs, _ = env.reset()\\n\",\n",
    "    \"        ep_return = 0.0\\n\",\n",
    "    \"        ep_len = 0\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        for _ in range(1000):\\n\",\n",
    "    \"            a = select_action(q_net, obs, eps=0.0, n_actions=env.action_space.n)\\n\",\n",
    "    \"            obs, r, terminated, truncated, _ = env.step(a)\\n\",\n",
    "    \"            ep_return += r\\n\",\n",
    "    \"            ep_len += 1\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            if terminated or truncated:\\n\",\n",
    "    \"                break\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        returns.append(ep_return)\\n\",\n",
    "    \"        lengths.append(ep_len)\\n\",\n",
    "    \"        successes.append(1 if ep_return >= 200 else 0)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    env.close()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'mean_return': np.mean(returns),\\n\",\n",
    "    \"        'std_return': np.std(returns),\\n\",\n",
    "    \"        'min_return': np.min(returns),\\n\",\n",
    "    \"        'max_return': np.max(returns),\\n\",\n",
    "    \"        'median_return': np.median(returns),\\n\",\n",
    "    \"        'mean_length': np.mean(lengths),\\n\",\n",
    "    \"        'success_rate': np.mean(successes) * 100,\\n\",\n",
    "    \"        'returns': returns,\\n\",\n",
    "    \"        'lengths': lengths\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Evaluate All Agents\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Evaluate all trained agents\\n\",\n",
    "    \"eval_results = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*80)\\n\",\n",
    "    \"print(\\\"Evaluating Trained Agents (50 episodes each)\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*80 + \\\"\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, res in results.items():\\n\",\n",
    "    \"    print(f\\\"Evaluating {name}...\\\")\\n\",\n",
    "    \"    eval_stats = evaluate_agent(\\n\",\n",
    "    \"        res['q_online'],\\n\",\n",
    "    \"        n_episodes=50,\\n\",\n",
    "    \"        wind_power=res['wind_power'],\\n\",\n",
    "    \"        turbulence_power=res['turbulence_power']\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    eval_results[name] = eval_stats\\n\",\n",
