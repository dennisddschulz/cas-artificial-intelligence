    "    \"    )\\n\",\n",
    "    \"    results[config['name']] = result\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Save checkpoint\\n\",\n",
    "    \"    torch.save(result['q_online'].state_dict(), f\\\"{config['name']}_checkpoint.pt\\\")\\n\",\n",
    "    \"    print(f\\\"  ✓ Saved checkpoint: {config['name']}_checkpoint.pt\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*80)\\n\",\n",
    "    \"print(\\\"Training Complete!\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*80)\"\n",
    "   ]\n",
    "  },\n",
