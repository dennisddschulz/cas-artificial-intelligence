    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Compare DQN vs Double DQN across wind conditions\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 2, figsize=(14, 10))\\n\",\n",
