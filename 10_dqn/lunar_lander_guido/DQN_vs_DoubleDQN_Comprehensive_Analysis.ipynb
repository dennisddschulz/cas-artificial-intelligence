    "    \"\\n\",\n",
    "    \"# Overestimation comparison\\n\",\n",
    "    \"ax = axes[0, 1]\\n\",\n",
    "    \"dqn_gaps = [r[\\\"gap\\\"][-1] if r and len(r[\\\"gap\\\"]) > 0 else 0 for r in dqn_results]\\n\",\n",
    "    \"ddqn_gaps = [r[\\\"gap\\\"][-1] if r and len(r[\\\"gap\\\"]) > 0 else 0 for r in ddqn_results]\\n\",\n",
    "    \"\\n\",\n",
    "    \"bars1 = ax.bar(x - width/2, dqn_gaps, width, label='DQN',\\n\",\n",
    "    \"               color='skyblue', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"bars2 = ax.bar(x + width/2, ddqn_gaps, width, label='Double DQN',\\n\",\n",
    "    \"               color='lightcoral', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_ylabel('Final Overestimation Gap', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"ax.set_title('Q-Value Overestimation', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"ax.set_xticks(x)\\n\",\n",
    "    \"ax.set_xticklabels(conditions)\\n\",\n",
    "    \"ax.legend(fontsize=10)\\n\",\n",
    "    \"ax.axhline(y=0, color='black', linestyle='-', alpha=0.3)\\n\",\n",
    "    \"ax.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Action distribution comparison\\n\",\n",
    "    \"ax = axes[1, 0]\\n\",\n",
    "    \"action_names = ['Nothing', 'Left', 'Main', 'Right']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Compare DQN vs Double DQN for no wind condition\\n\",\n",
    "    \"dqn_no_wind = results.get('DQN_NoWind')\\n\",\n",
    "    \"ddqn_no_wind = results.get('DoubleDQN_NoWind')\\n\",\n",
    "    \"\\n\",\n",
    "    \"if dqn_no_wind and ddqn_no_wind:\\n\",\n",
    "    \"    dqn_counts = dqn_no_wind['action_counts']\\n\",\n",
    "    \"    ddqn_counts = ddqn_no_wind['action_counts']\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    dqn_total = sum(dqn_counts.values())\\n\",\n",
    "    \"    ddqn_total = sum(ddqn_counts.values())\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    dqn_pcts = [dqn_counts[i]/dqn_total*100 for i in range(4)]\\n\",\n",
    "    \"    ddqn_pcts = [ddqn_counts[i]/ddqn_total*100 for i in range(4)]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    x_act = np.arange(len(action_names))\\n\",\n",
    "    \"    bars1 = ax.bar(x_act - width/2, dqn_pcts, width, label='DQN',\\n\",\n",
    "    \"                   color='skyblue', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    bars2 = ax.bar(x_act + width/2, ddqn_pcts, width, label='Double DQN',\\n\",\n",
    "    \"                   color='lightcoral', alpha=0.8, edgecolor='black')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax.set_ylabel('Percentage (%)', fontsize=11, fontweight='bold')\\n\",\n",
    "    \"    ax.set_title('Action Distribution (No Wind)', fontsize=13, fontweight='bold')\\n\",\n",
    "    \"    ax.set_xticks(x_act)\\n\",\n",
    "    \"    ax.set_xticklabels(action_names)\\n\",\n",
    "    \"    ax.legend(fontsize=10)\\n\",\n",
    "    \"    ax.grid(True, alpha=0.3, axis='y')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Learning efficiency\\n\",\n",
    "    \"ax = axes[1, 1]\\n\",\n",
    "    \"for name, res in results.items():\\n\",\n",
    "    \"    if 'NoWind' in name:\\n\",\n",
    "    \"        window = 100\\n\",\n",
    "    \"        smoothed = moving_average(res[\\\"episode_returns\\\"], window)\\n\",\n",
    "    \"        episodes = np.arange(window//2, window//2 + len(smoothed))\\n\",\n",
    "    \"        ax.plot(episodes, smoothed, label=name, linewidth=2.5, alpha=0.9)\\n\",\n",
    "    \"\\n\",\n",
