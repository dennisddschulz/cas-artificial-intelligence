    "   \"source\": [\n",
    "    \"# Plot training curves\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 3, figsize=(18, 10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Episode Returns\\n\",\n",
