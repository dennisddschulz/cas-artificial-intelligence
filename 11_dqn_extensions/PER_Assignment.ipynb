    "    \"print(f\\\"PER Alpha: {PER_ALPHA}, Beta Start: {PER_BETA_START}, Beta End: {PER_BETA_END}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
