    "    \"PER_BETA_START = 0.4\\n\",\n",
    "    \"PER_BETA_END = 1.0\\n\",\n",
    "    \"PER_BETA_STEPS = 60_000\\n\",\n",
    "    \"PER_EPS = 1e-6\\n\",\n",
    "    \"\\n\",\n",
