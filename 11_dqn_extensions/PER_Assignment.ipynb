    "    \"---\\n\",\n",
    "    \"## TEIL 4: ENVIRONMENT UND UTILITY FUNKTIONEN\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def seed_everything(seed: int):\\n\",\n",
    "    \"    \\\"\\\"\\\"Set seed for reproducibility\\\"\\\"\\\"\\n\",\n",
    "    \"    random.seed(seed)\\n\",\n",
    "    \"    np.random.seed(seed)\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        torch.cuda.manual_seed_all(seed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_env(env_id: str, seed: int):\\n\",\n",
    "    \"    \\\"\\\"\\\"Create environment\\\"\\\"\\\"\\n\",\n",
    "    \"    env = gym.make(env_id)\\n\",\n",
    "    \"    env.reset(seed=seed)\\n\",\n",
    "    \"    env.action_space.seed(seed)\\n\",\n",
    "    \"    return env\\n\",\n",
    "    \"\\n\",\n",
    "    \"seed_everything(SEED)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create environment to get dimensions\\n\",\n",
    "    \"env_temp = make_env(ENV_ID, SEED)\\n\",\n",
    "    \"obs_dim = env_temp.observation_space.shape[0]\\n\",\n",
    "    \"n_actions = env_temp.action_space.n\\n\",\n",
    "    \"env_temp.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Observation dimension: {obs_dim}\\\")\\n\",\n",
    "    \"print(f\\\"Number of actions: {n_actions}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 5: REPLAY BUFFER IMPLEMENTIERUNGEN\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Transition Definition\\n\",\n",
    "    \"Transition = namedtuple(\\\"Transition\\\", [\\\"s\\\", \\\"a\\\", \\\"r\\\", \\\"s2\\\", \\\"done\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"# UNIFORM REPLAY BUFFER\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class UniformReplayBuffer:\\n\",\n",
    "    \"    \\\"\\\"\\\"Standard Experience Replay Buffer - baseline comparison\\\"\\\"\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, capacity: int):\\n\",\n",
    "    \"        self.buf = deque(maxlen=capacity)\\n\",\n",
    "    \"        self.capacity = capacity\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.buf)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def add(self, s, a, r, s2, done):\\n\",\n",
    "    \"        self.buf.append(Transition(s, a, r, s2, done))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def sample(self, batch_size: int):\\n\",\n",
    "    \"        batch = random.sample(self.buf, batch_size)\\n\",\n",
    "    \"        return self._to_tensors(batch), None, None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    @staticmethod\\n\",\n",
    "    \"    def _to_tensors(batch):\\n\",\n",
    "    \"        s  = torch.tensor(np.array([b.s for b in batch]), dtype=torch.float32, device=device)\\n\",\n",
    "    \"        a  = torch.tensor(np.array([b.a for b in batch]), dtype=torch.int64, device=device).unsqueeze(-1)\\n\",\n",
    "    \"        r  = torch.tensor(np.array([b.r for b in batch]), dtype=torch.float32, device=device).unsqueeze(-1)\\n\",\n",
    "    \"        s2 = torch.tensor(np.array([b.s2 for b in batch]), dtype=torch.float32, device=device)\\n\",\n",
    "    \"        d  = torch.tensor(np.array([b.done for b in batch]), dtype=torch.float32, device=device).unsqueeze(-1)\\n\",\n",
    "    \"        return s, a, r, s2, d\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# SUMTREE - für PER\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class SumTree:\\n\",\n",
    "    \"    \\\"\\\"\\\"Efficient SumTree data structure for PER\\\"\\\"\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, capacity: int):\\n\",\n",
    "    \"        self.capacity = capacity\\n\",\n",
    "    \"        self.tree = np.zeros(2 * capacity - 1, dtype=np.float32)\\n\",\n",
    "    \"        self.data = np.empty(capacity, dtype=object)\\n\",\n",
    "    \"        self.write = 0\\n\",\n",
    "    \"        self.size = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def total(self) -> float:\\n\",\n",
    "    \"        return float(self.tree[0])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def add(self, p: float, data):\\n\",\n",
    "    \"        leaf_idx = self.write + (self.capacity - 1)\\n\",\n",
    "    \"        self.data[self.write] = data\\n\",\n",
    "    \"        self.update(leaf_idx, p)\\n\",\n",
    "    \"        self.write = (self.write + 1) % self.capacity\\n\",\n",
    "    \"        self.size = min(self.size + 1, self.capacity)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def update(self, idx: int, p: float):\\n\",\n",
    "    \"        change = p - self.tree[idx]\\n\",\n",
    "    \"        self.tree[idx] = p\\n\",\n",
    "    \"        while idx != 0:\\n\",\n",
    "    \"            idx = (idx - 1) // 2\\n\",\n",
    "    \"            self.tree[idx] += change\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get(self, s: float):\\n\",\n",
    "    \"        \\\"\\\"\\\"Find leaf by priority value\\\"\\\"\\\"\\n\",\n",
    "    \"        idx = 0\\n\",\n",
    "    \"        while True:\\n\",\n",
    "    \"            left = 2 * idx + 1\\n\",\n",
    "    \"            right = left + 1\\n\",\n",
    "    \"            if left >= len(self.tree):\\n\",\n",
    "    \"                break\\n\",\n",
    "    \"            if s <= self.tree[left]:\\n\",\n",
    "    \"                idx = left\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                s -= self.tree[left]\\n\",\n",
    "    \"                idx = right\\n\",\n",
    "    \"        data_idx = idx - (self.capacity - 1)\\n\",\n",
    "    \"        return idx, float(self.tree[idx]), self.data[data_idx]\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# PRIORITIZED REPLAY BUFFER\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class PrioritizedReplayBuffer:\\n\",\n",
    "    \"    \\\"\\\"\\\"Prioritized Experience Replay with SumTree\\\"\\\"\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, capacity: int, alpha: float):\\n\",\n",
    "    \"        self.alpha = alpha\\n\",\n",
    "    \"        self.tree = SumTree(capacity)\\n\",\n",
    "    \"        self.max_priority = 1.0\\n\",\n",
    "    \"        self.capacity = capacity\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return self.tree.size\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def add(self, s, a, r, s2, done):\\n\",\n",
    "    \"        data = Transition(s, a, r, s2, done)\\n\",\n",
    "    \"        # Neue Transitions bekommen max Priorität\\n\",\n",
    "    \"        p = (self.max_priority + PER_EPS) ** self.alpha\\n\",\n",
    "    \"        self.tree.add(p, data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def sample(self, batch_size: int, beta: float):\\n\",\n",
    "    \"        total = self.tree.total()\\n\",\n",
    "    \"        if total <= 0:\\n\",\n",
    "    \"            raise RuntimeError(\\\"SumTree total priority is zero\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        batch = []\\n\",\n",
    "    \"        idxs = []\\n\",\n",
    "    \"        priorities = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Teile die Prioritäts-Range in batch_size Segmente\\n\",\n",
    "    \"        segment = total / batch_size\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for i in range(batch_size):\\n\",\n",
    "    \"            a = segment * i\\n\",\n",
    "    \"            b = segment * (i + 1)\\n\",\n",
    "    \"            s = random.uniform(a, b)\\n\",\n",
    "    \"            idx, p, data = self.tree.get(s)\\n\",\n",
    "    \"            batch.append(data)\\n\",\n",
    "    \"            idxs.append(idx)\\n\",\n",
    "    \"            priorities.append(p)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Berechne Importance Sampling Weights\\n\",\n",
    "    \"        probs = np.array(priorities, dtype=np.float32) / (total + 1e-8)\\n\",\n",
    "    \"        probs = np.clip(probs, 1e-8, None)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        weights = (len(self) * probs) ** (-beta)\\n\",\n",
    "    \"        weights = weights / (weights.max() + 1e-8)\\n\",\n",
    "    \"        weights_t = torch.tensor(weights, dtype=torch.float32, device=device).unsqueeze(-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return UniformReplayBuffer._to_tensors(batch), idxs, weights_t\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def update_priorities(self, idxs, priorities):\\n\",\n",
    "    \"        for idx, p in zip(idxs, priorities):\\n\",\n",
    "    \"            p = max(float(p), PER_EPS)\\n\",\n",
    "    \"            self.max_priority = max(self.max_priority, p)\\n\",\n",
    "    \"            self.tree.update(idx, (p ** self.alpha))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 6: NEURAL NETWORK\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class QNetwork(nn.Module):\\n\",\n",
    "    \"    \\\"\\\"\\\"Deep Q-Network with Dueling architecture\\\"\\\"\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    def __init__(self, obs_dim, n_actions, hidden=128):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"        self.feature = nn.Sequential(\\n\",\n",
    "    \"            nn.Linear(obs_dim, hidden),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden, hidden),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Dueling Architecture\\n\",\n",
    "    \"        self.value = nn.Sequential(\\n\",\n",
    "    \"            nn.Linear(hidden, hidden // 2),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden // 2, 1)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        self.adv = nn.Sequential(\\n\",\n",
    "    \"            nn.Linear(hidden, hidden // 2),\\n\",\n",
    "    \"            nn.ReLU(),\\n\",\n",
    "    \"            nn.Linear(hidden // 2, n_actions)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        z = self.feature(x)\\n\",\n",
    "    \"        v = self.value(z)\\n\",\n",
    "    \"        a = self.adv(z)\\n\",\n",
    "    \"        a = a - a.mean(dim=1, keepdim=True)\\n\",\n",
    "    \"        return v + a\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"QNetwork created for obs_dim={obs_dim}, n_actions={n_actions}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 7: TRAINING FUNCTIONS\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def epsilon_by_step(step):\\n\",\n",
    "    \"    \\\"\\\"\\\"Epsilon schedule\\\"\\\"\\\"\\n\",\n",
    "    \"    if step >= EPS_DECAY_STEPS:\\n\",\n",
    "    \"        return EPS_END\\n\",\n",
    "    \"    frac = step / EPS_DECAY_STEPS\\n\",\n",
    "    \"    return EPS_START + frac * (EPS_END - EPS_START)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_beta(step):\\n\",\n",
    "    \"    \\\"\\\"\\\"Beta schedule for importance sampling correction\\\"\\\"\\\"\\n\",\n",
    "    \"    if step >= PER_BETA_STEPS:\\n\",\n",
    "    \"        return PER_BETA_END\\n\",\n",
    "    \"    frac = step / PER_BETA_STEPS\\n\",\n",
    "    \"    return PER_BETA_START + frac * (PER_BETA_END - PER_BETA_START)\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def select_action(obs, step, q_network):\\n\",\n",
    "    \"    \\\"\\\"\\\"Select action with epsilon-greedy\\\"\\\"\\\"\\n\",\n",
    "    \"    obs_t = torch.tensor(obs, dtype=torch.float32, device=device).unsqueeze(0)\\n\",\n",
    "    \"    eps = epsilon_by_step(step)\\n\",\n",
    "    \"    if random.random() < eps:\\n\",\n",
    "    \"        return np.random.randint(n_actions)\\n\",\n",
    "    \"    qvals = q_network(obs_t)\\n\",\n",
    "    \"    return int(qvals.argmax(dim=1).item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def compute_target(s2, r, done, q_online, q_target):\\n\",\n",
    "    \"    \\\"\\\"\\\"Double DQN target\\\"\\\"\\\"\\n\",\n",
    "    \"    a2 = q_online(s2).argmax(dim=1, keepdim=True)\\n\",\n",
    "    \"    q2 = q_target(s2).gather(1, a2)\\n\",\n",
    "    \"    return r + GAMMA * (1.0 - done) * q2\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_step(q_online, q_target, optimizer, buffer, step, use_per):\\n\",\n",
    "    \"    \\\"\\\"\\\"Single training step\\\"\\\"\\\"\\n\",\n",
    "    \"    if len(buffer) < max(LEARNING_STARTS, BATCH_SIZE):\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Sample from buffer\\n\",\n",
    "    \"    if use_per:\\n\",\n",
    "    \"        beta = compute_beta(step)\\n\",\n",
    "    \"        (s, a, r, s2, done), idxs, weights = buffer.sample(BATCH_SIZE, beta=beta)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        (s, a, r, s2, done), idxs, weights = buffer.sample(BATCH_SIZE)\\n\",\n",
    "    \"        weights = torch.ones((BATCH_SIZE, 1), device=device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Forward pass\\n\",\n",
    "    \"    q = q_online(s).gather(1, a)\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        y = compute_target(s2, r, done, q_online, q_target)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # TD Error\\n\",\n",
    "    \"    td_err = (y - q)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Loss\\n\",\n",
    "    \"    loss = (weights * td_err.pow(2)).mean()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Backprop\\n\",\n",
    "    \"    optimizer.zero_grad()\\n\",\n",
    "    \"    loss.backward()\\n\",\n",
    "    \"    nn.utils.clip_grad_norm_(q_online.parameters(), GRAD_CLIP_NORM)\\n\",\n",
    "    \"    optimizer.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Update priorities (PER only)\\n\",\n",
    "    \"    if use_per:\\n\",\n",
    "    \"        prios = td_err.detach().abs().squeeze(-1).cpu().numpy() + PER_EPS\\n\",\n",
    "    \"        buffer.update_priorities(idxs, prios)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Soft update target network\\n\",\n",
    "    \"    if SOFT_UPDATE:\\n\",\n",
    "    \"        with torch.no_grad():\\n\",\n",
    "    \"            for p_t, p in zip(q_target.parameters(), q_online.parameters()):\\n\",\n",
    "    \"                p_t.data.mul_(1 - TAU).add_(TAU * p.data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return float(loss.item()), td_err.detach().abs().mean().item()\\n\",\n",
    "    \"\\n\",\n",
    "    \"@torch.no_grad()\\n\",\n",
    "    \"def evaluate(q_network, env_id, episodes=5):\\n\",\n",
    "    \"    \\\"\\\"\\\"Evaluate agent\\\"\\\"\\\"\\n\",\n",
    "    \"    e = make_env(env_id, SEED + 999)\\n\",\n",
    "    \"    returns = []\\n\",\n",
    "    \"    for _ in range(episodes):\\n\",\n",
    "    \"        obs, _ = e.reset()\\n\",\n",
    "    \"        done = False\\n\",\n",
    "    \"        total = 0.0\\n\",\n",
    "    \"        while not done:\\n\",\n",
    "    \"            obs_t = torch.tensor(obs, dtype=torch.float32, device=device).unsqueeze(0)\\n\",\n",
    "    \"            a = int(q_network(obs_t).argmax(dim=1).item())\\n\",\n",
    "    \"            obs, r, terminated, truncated, _ = e.step(a)\\n\",\n",
    "    \"            done = terminated or truncated\\n\",\n",
    "    \"            total += r\\n\",\n",
    "    \"        returns.append(total)\\n\",\n",
    "    \"    e.close()\\n\",\n",
    "    \"    return float(np.mean(returns)), float(np.std(returns))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 8: TRAINING LOOP FUNCTION\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def run_training(config_key: str, config: dict):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Run complete training experiment.\\n\",\n",
    "    \"    Returns collected metrics.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    print(f\\\"\\\\n{'='*70}\\\")\\n\",\n",
    "    \"    print(f\\\"Starting Training: {config['name']}\\\")\\n\",\n",
    "    \"    print(f\\\"{'='*70}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    use_per = config['use_per']\\n\",\n",
    "    \"    seed_everything(SEED)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create networks\\n\",\n",
    "    \"    q_online = QNetwork(obs_dim, n_actions).to(device)\\n\",\n",
    "    \"    q_target = QNetwork(obs_dim, n_actions).to(device)\\n\",\n",
    "    \"    q_target.load_state_dict(q_online.state_dict())\\n\",\n",
    "    \"    q_target.eval()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create optimizer\\n\",\n",
    "    \"    optimizer = optim.Adam(q_online.parameters(), lr=LR)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create buffer\\n\",\n",
    "    \"    if use_per:\\n\",\n",
    "    \"        buffer = PrioritizedReplayBuffer(BUFFER_SIZE, alpha=PER_ALPHA)\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        buffer = UniformReplayBuffer(BUFFER_SIZE)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create environment\\n\",\n",
    "    \"    env = make_env(ENV_ID, SEED)\\n\",\n",
    "    \"    q_online.train()\\n\",\n",
    "    \"    q_target.eval()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Metrics\\n\",\n",
    "    \"    losses = []\\n\",\n",
    "    \"    td_errors = []\\n\",\n",
    "    \"    eval_steps = []\\n\",\n",
    "    \"    eval_means = []\\n\",\n",
    "    \"    eval_stds = []\\n\",\n",
    "    \"    episode_returns = []\\n\",\n",
    "    \"    episode_lengths = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Training loop\\n\",\n",
    "    \"    obs, _ = env.reset()\\n\",\n",
    "    \"    episode_return = 0.0\\n\",\n",
    "    \"    episode_len = 0\\n\",\n",
    "    \"    start_time = time.time()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for step in tqdm(range(1, TOTAL_STEPS + 1), desc=config['name']):\\n\",\n",
    "    \"        # Action selection\\n\",\n",
    "    \"        a = select_action(obs, step, q_online)\\n\",\n",
    "    \"        obs2, r, terminated, truncated, _ = env.step(a)\\n\",\n",
    "    \"        done = terminated or truncated\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Store transition\\n\",\n",
    "    \"        buffer.add(obs, a, r, obs2, done)\\n\",\n",
    "    \"        obs = obs2\\n\",\n",
    "    \"        episode_return += r\\n\",\n",
    "    \"        episode_len += 1\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Training step\\n\",\n",
    "    \"        if step % TRAIN_FREQ == 0 and len(buffer) >= max(LEARNING_STARTS, BATCH_SIZE):\\n\",\n",
    "    \"            loss, td_err = train_step(q_online, q_target, optimizer, buffer, step, use_per)\\n\",\n",
    "    \"            if loss is not None:\\n\",\n",
    "    \"                losses.append(loss)\\n\",\n",
    "    \"                td_errors.append(td_err)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Episode end\\n\",\n",
    "    \"        if done:\\n\",\n",
    "    \"            episode_returns.append(episode_return)\\n\",\n",
    "    \"            episode_lengths.append(episode_len)\\n\",\n",
    "    \"            obs, _ = env.reset()\\n\",\n",
    "    \"            episode_return = 0.0\\n\",\n",
    "    \"            episode_len = 0\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Evaluation\\n\",\n",
    "    \"        if step % EVAL_EVERY == 0:\\n\",\n",
    "    \"            mean_r, std_r = evaluate(q_online, ENV_ID, episodes=EVAL_EPISODES)\\n\",\n",
    "    \"            eval_steps.append(step)\\n\",\n",
    "    \"            eval_means.append(mean_r)\\n\",\n",
    "    \"            eval_stds.append(std_r)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    env.close()\\n\",\n",
    "    \"    elapsed = time.time() - start_time\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print(f\\\"\\\\nTraining completed in {elapsed:.1f}s\\\")\\n\",\n",
    "    \"    print(f\\\"Final eval return: {eval_means[-1]:.1f} ± {eval_stds[-1]:.1f}\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Return results\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        'config_key': config_key,\\n\",\n",
    "    \"        'config_name': config['name'],\\n\",\n",
    "    \"        'use_per': use_per,\\n\",\n",
    "    \"        'color': config['color'],\\n\",\n",
    "    \"        'losses': losses,\\n\",\n",
    "    \"        'td_errors': td_errors,\\n\",\n",
    "    \"        'eval_steps': eval_steps,\\n\",\n",
    "    \"        'eval_means': eval_means,\\n\",\n",
    "    \"        'eval_stds': eval_stds,\\n\",\n",
    "    \"        'episode_returns': episode_returns,\\n\",\n",
    "    \"        'episode_lengths': episode_lengths,\\n\",\n",
    "    \"        'elapsed_time': elapsed,\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 9: TRAININGS-EXPERIMENTE\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# EXPERIMENT 1: UNIFORM REPLAY\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_uniform = run_training('uniform', CONFIG['uniform'])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# EXPERIMENT 2: PRIORITIZED EXPERIENCE REPLAY\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_per = run_training('per', CONFIG['per'])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"---\\n\",\n",
    "    \"## TEIL 10: DETAILLIERTE VISUALISIERUNGEN\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Combine results\\n\",\n",
    "    \"all_results = [results_uniform, results_per]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*70)\\n\",\n",
    "    \"print(\\\"VERGLEICH: Uniform Replay vs. PER\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*70)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Summary statistics\\n\",\n",
    "    \"for res in all_results:\\n\",\n",
    "    \"    print(f\\\"\\\\n{res['config_name']}:\\\")\\n\",\n",
    "    \"    print(f\\\"  Final Return:        {res['eval_means'][-1]:.2f} ± {res['eval_stds'][-1]:.2f}\\\")\\n\",\n",
    "    \"    print(f\\\"  Max Return:          {max(res['eval_means']):.2f}\\\")\\n\",\n",
    "    \"    print(f\\\"  Avg Episode Return:  {np.mean(res['episode_returns']):.2f}\\\")\\n\",\n",
    "    \"    print(f\\\"  Training Time:       {res['elapsed_time']:.1f}s\\\")\\n\",\n",
    "    \"    print(f\\\"  Avg Loss:            {np.mean(res['losses']):.6f}\\\")\\n\",\n",
    "    \"    print(f\\\"  Avg TD-Error:        {np.mean(res['td_errors']):.6f}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# VISUALIZATION 1: Evaluation Return Comparison\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(14, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for res in all_results:\\n\",\n",
    "    \"    mean = np.array(res['eval_means'])\\n\",\n",
