    "    \"source\": [\n",
    "    \"# Save results for presentation\\n\",\n",
    "    \"results_summary = {\\n\",\n",
    "    \"    'uniform': results_uniform,\\n\",\n",
    "    \"    'per': results_per,\\n\",\n",
    "    \"    'analysis': analysis,\\n\",\n",
    "    \"    'improvement_percent': improvement_percent,\\n\",\n",
    "    \"    'p_value': p_value,\\n\",\n",
    "    \"    'cohens_d': cohens_d,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"with open('/home/isc-den/cas-artificial-intelligence/11_dqn_extensions/results_summary.json', 'w') as f:\\n\",\n",
    "    \"    # Convert to JSON-serializable format\\n\",\n",
    "    \"    json_results = {\\n\",\n",
    "    \"        'uniform': {\\n\",\n",
    "    \"            'config_name': results_uniform['config_name'],\\n\",\n",
    "    \"            'eval_means': [float(x) for x in results_uniform['eval_means']],\\n\",\n",
    "    \"            'eval_stds': [float(x) for x in results_uniform['eval_stds']],\\n\",\n",
    "    \"            'eval_steps': [int(x) for x in results_uniform['eval_steps']],\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"        'per': {\\n\",\n",
    "    \"            'config_name': results_per['config_name'],\\n\",\n",
    "    \"            'eval_means': [float(x) for x in results_per['eval_means']],\\n\",\n",
    "    \"            'eval_stds': [float(x) for x in results_per['eval_stds']],\\n\",\n",
    "    \"            'eval_steps': [int(x) for x in results_per['eval_steps']],\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"        'improvement_percent': float(improvement_percent),\\n\",\n",
    "    \"        'p_value': float(p_value),\\n\",\n",
    "    \"        'cohens_d': float(cohens_d),\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"    json.dump(json_results, f, indent=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Results saved to results_summary.json\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
