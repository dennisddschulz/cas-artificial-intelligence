    "   \"source\": [\n",
    "    \"# ============================================\\n\",\n",
    "    \"# EXPERIMENT CONFIGURATION\\n\",\n",
    "    \"# ============================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Zwei separate Konfigurationen: Mit und Ohne PER\\n\",\n",
    "    \"CONFIG = {\\n\",\n",
    "    \"    'uniform': {\\n\",\n",
    "    \"        'name': 'Uniform Replay (Baseline)',\\n\",\n",
    "    \"        'use_per': False,\\n\",\n",
    "    \"        'color': '#1f77b4',  # blue\\n\",\n",
    "    \"    },\\n\",\n",
